# Hive Gateway (透明代理网关) - {{ .Title }}
# Generated by hive-registry — 由 hive-clash-sync 拉取并热重载，请勿手改

mixed-port: 7890
allow-lan: true
mode: Rule
log-level: info
ipv6: true
find-process-mode: always
unified-delay: true
tcp-concurrent: true
keep-alive-interval: 15
global-client-fingerprint: chrome

# 局域网可视化面板（MetaCubeXD）：external-controller 监听全网段，
# 同网段设备可访问 http://<lan-ip>:9090/ui。secret 使用服务端独立密钥派生做 API 鉴权。
external-controller: 0.0.0.0:9090
secret: "{{ .Secret }}"
external-ui: "{{ .DashboardPath }}"
external-ui-name: metacubexd

geodata-mode: true
geo-auto-update: true
geo-update-interval: 24

profile:
  store-selected: true
  store-fake-ip: true

# TPROXY（只接管 LAN/AP 转发流量）：
# 本机自身出站不进 tproxy，Xray 出口/registry/cloudflared 等控制面天然直连。
# nft 规则与 fwmark ip rule 由 hive-gateway-route.service 安装；
# 客户端 DNS 由同一 nft 链 redirect 到 dns.listen。
tproxy-port: 7893

sniffer:
  enable: true
  parse-pure-ip: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
      override-destination: true
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

dns:
  enable: true
  listen: 0.0.0.0:1053
  cache-algorithm: arc
  # DNS 传输不能过规则：节点没有可用上游时终端规则是 REJECT，
  # mihomo 自己的 DoH 会被自己掐死（实测 mihomo --> 223.5.5.5:443 REJECT），
  # 节点随之解析不出 registry/tailscale 域名、面板永久离线。
  respect-rules: false
  use-hosts: true
  use-system-hosts: true
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - '+.tailscale.com'
    - '+.tailscale.io'
    - rule-set:private_domain
    - rule-set:cn_domain
  proxy-server-nameserver:
    - https://223.5.5.5/dns-query
    - https://1.1.1.1/dns-query
  direct-nameserver:
    - https://223.5.5.5/dns-query
    - https://223.6.6.6/dns-query
  nameserver:
    - https://223.5.5.5/dns-query
    - https://223.6.6.6/dns-query
    - https://1.1.1.1/dns-query

proxies:
  - name: "直连"
    type: direct
    udp: true
{{ range .Proxies }}
  - name: {{ .Name }}
    type: vless
    server: {{ .Server }}
    port: 443
    uuid: {{ .UUID }}
    network: ws
    tls: true
    udp: true
    servername: {{ .Host }}
    ws-opts:
      path: /{{ $.XrayPath }}
      headers:
        Host: {{ .Host }}
      max-early-data: 2560
      early-data-header-name: Sec-WebSocket-Protocol
{{ end }}
proxy-groups:
{{ if .HasUpstream }}
  # 代理：默认指向"自动选择"，可在面板切到"手动选择"或具体节点
  - name: 代理
    type: select
    proxies: [自动选择, 手动选择, 直连]

  # 自动选择：url-test 在全部上游里挑最快（已在后端排除本节点，不会自选自己）
  - name: 自动选择
    type: url-test
    include-all: true
    exclude-type: direct
    tolerance: 10
    url: http://www.gstatic.com/generate_204
    interval: 300

  # 手动选择：UI 里手动指定上游出口
  - name: 手动选择
    type: select
    proxies: [{{ range $i, $n := .ManualProxyNames }}{{ if $i }}, {{ end }}{{ $n | printf "%q" }}{{ end }}{{ if not .ManualProxyNames }}直连{{ end }}]
{{ end }}
rule-anchor:
  # 规则集下载必须直连：mihomo 拉 rule-provider 也走规则引擎，而本配置末尾是
  # MATCH,代理。若先走代理，上游不可用时下载会 EOF，规则集全空 → 所有流量继续
  # MATCH,代理 → 热点客户端“连上就断网”。proxy: DIRECT 打破这个死锁。
  ip: &ip {type: http, interval: 86400, behavior: ipcidr, format: mrs, proxy: DIRECT}
  domain: &domain {type: http, interval: 86400, behavior: domain, format: mrs, proxy: DIRECT}

rule-providers:
{{ range .DomainProviders }}
  {{ .Key }}:
    <<: *domain
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/{{ .File }}.mrs"
{{ end }}
{{ range .IPProviders }}
  {{ .Key }}:
    <<: *ip
    url: "https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/{{ .File }}.mrs"
{{ end }}
rules:
  # 节点自身出站永远直连：auto-route 把本机流量也送进 TUN，源地址就是 TUN 地址。
  # PROCESS-NAME 在这块板子上匹配不到（见 docs/GATEWAY.md），而 registry/FRP 等
  # 控制面域名都是普通 .cn 名，会命中 cn_domain 之类的 REJECT —— 漏掉这条，节点
  # 既拉不到订阅也发不出心跳，面板永久离线。
  - SRC-IP-CIDR,198.18.0.1/32,DIRECT
  # IPv6 同样要放行：auto-route 也接管 ::/1，EasyTier 对端的 v6 直连包
  # 会带着 TUN 的 v6 源地址进来，漏了它就被 MATCH/规则集 REJECT。
  - SRC-IP-CIDR,fdfe:dcba:9876::1/128,DIRECT
  # ── 防回环：本机自身出站守护进程一律直连，绝不进代理 ──
{{ range .LocalProcessNames }}
  - PROCESS-NAME,{{ . }},直连
{{ end }}
  # ── 私有/本地网段直连 ──
  - RULE-SET,private_domain,直连
  - RULE-SET,private_ip,直连,no-resolve
  # ── 国内（geosite/geoip CN）：按节点方向决定走向 ──
  - RULE-SET,cn_domain,{{ .CNAction }}
  - RULE-SET,cn_ip,{{ .CNAction }},no-resolve
  # ── 其余流量：按节点方向决定走向 ──
  - MATCH,{{ .OtherAction }}
