# 密钥和敏感配置
.env
*.secret
*.key
*.pem
*.p12

# OTA 签名私钥（公钥在 overlay 里需要入库）
keys/
!armbian-build/userpatches/overlay/etc/hive/ota-pubkey.pem

# Armbian 框架本体（由 scripts/setup-armbian.sh clone，不入库）
# 仅追踪 armbian-build/userpatches/ 下的自定义文件
armbian-build/*
!armbian-build/userpatches/

# 渲染后的实际配置（含密钥，由 build.sh 生成，不入库）
armbian-build/userpatches/overlay/etc/hive/config.env
armbian-build/userpatches/overlay/etc/frp/frpc.toml

# 预编译二进制（由 scripts/download-binaries.sh 下载，不入库）
armbian-build/userpatches/overlay/usr/local/bin/xray
armbian-build/userpatches/overlay/usr/local/bin/xray-exporter
armbian-build/userpatches/overlay/usr/local/bin/cloudflared
armbian-build/userpatches/overlay/usr/local/bin/frpc
armbian-build/userpatches/overlay/usr/local/bin/easytier-core
armbian-build/userpatches/overlay/usr/local/bin/mihomo

# metacubexd Web 面板静态资源（由 scripts/download-binaries.sh 下载，不入库）
armbian-build/userpatches/overlay/var/www/metacubexd/

# 镜像文件
*.img
*.img.xz
*.img.zst

# 构建产物：OTA bundle 与 A/B 镜像目录。*.img 只覆盖镜像本身，
# build-ab-image.sh 还会写 hive-*-ab-*.sha256，漏掉就变成未跟踪文件。
output/

# VitePress
node_modules/
docs/.vitepress/dist/
docs/.vitepress/cache/

# 编辑器
.vscode/
.idea/
*.swp
*~

# Python 字节码（测试运行产生）
__pycache__/
*.pyc
