#!/bin/bash
#
# Hive Network Services Status Display
# Custom MOTD script for Hive Network Node

THIS_SCRIPT="hive-services"
MOTD_DISABLE=""

safe_source() { [[ -f "$1" ]] && . "$1"; }

# Load MOTD config
safe_source /etc/default/armbian-motd
for f in ${MOTD_DISABLE}; do
    [[ "${f}" == "${THIS_SCRIPT}" ]] && exit 0
done

# Load hive node configuration
safe_source /etc/hive/config.env
if [[ -f /etc/hive/node-info ]]; then
    source /usr/local/bin/hive-node-info
    hive_load_node_info
fi

# No wireless NIC is a valid configuration (wired-only board). Detect it once
# so the service and connection sections don't show a stale hotspot as stopped.
WLAN_PRESENT=0
for _wl in /sys/class/net/*/phy80211; do
    [[ -e "$_wl" ]] && WLAN_PRESENT=1 && break
done

# ── 并行：后台网络检测 + 一次性批量读取所有服务状态 ─────────
_TMP=$(mktemp -d)

ping -c1 -W2 8.8.8.8 >/dev/null 2>&1 \
    && echo "connected" > "${_TMP}/inet" \
    || echo "disconnected" > "${_TMP}/inet" &
_INET_PID=$!

if command -v tailscale &>/dev/null; then
    tailscale status --peers=false >/dev/null 2>&1 \
        && echo "connected" > "${_TMP}/ts" \
        || echo "disconnected" > "${_TMP}/ts" &
    _TS_PID=$!
fi

# 一次 systemctl 拿到所有单元状态（替代 N×2 次 fork）
declare -A _SVC_ACTIVE _SVC_ENABLED
while IFS=$'\t' read -r unit active; do
    _SVC_ACTIVE["$unit"]="$active"
done < <(systemctl list-units --type=service --all --no-legend --no-pager \
    --plain -o cat 2>/dev/null | awk '{printf "%s\t%s\n", $1, $3}')
while IFS=$'\t' read -r unit state; do
    _SVC_ENABLED["$unit"]="$state"
done < <(systemctl list-unit-files --type=service --no-legend --no-pager \
    --plain 2>/dev/null | awk '{printf "%s\t%s\n", $1, $2}')
# ──────────────────────────────────────────────────────────

check_service() {
    local svc="${1}.service"
    local display_name="$2"
    local config_check="$3"

    local status="⭕ Disabled"
    local color="\e[0;91m"

    local en="${_SVC_ENABLED[$svc]:-disabled}"
    local ac="${_SVC_ACTIVE[$svc]:-inactive}"

    if [[ "$en" == "enabled" || "$en" == "static" ]]; then
        if [[ "$ac" == "active" ]]; then
            status="🟢 Running"; color="\e[0;92m"
        else
            status="🟡 Stopped"; color="\e[0;93m"
        fi
    fi

    local config_status=" (not configured)"
    if [[ -n "$config_check" ]] && eval "$config_check" &>/dev/null; then
        config_status=" (configured)"
    fi

    printf " \e[1;36m%-18s\e[0m: %b%s\e[0m%s\n" "$display_name" "$color" "$status" "$config_status"
}

# Provisioning is a one-shot service: after success it is intentionally
# disabled and /etc/hive/provisioned exists. Showing "Disabled" there is
# misleading; report the lifecycle state instead.
check_provision() {
    local status color
    if [[ -f /etc/hive/provisioned ]]; then
        status="🟢 Provisioned"; color="\e[0;92m"
    elif [[ -s /etc/hive/provision-blocked ]]; then
        status="⭕ Blocked"; color="\e[0;91m"
    elif [[ "${_SVC_ACTIVE[provision-node.service]:-inactive}" == "active" ||
            "${_SVC_ACTIVE[provision-node.service]:-inactive}" == "activating" ]]; then
        status="🟡 Running"; color="\e[0;93m"
    else
        status="⭕ Not provisioned"; color="\e[0;91m"
    fi
    printf " \e[1;36m%-18s\e[0m: %b%s\e[0m\n" "Node Provision" "$color" "$status"
}

# A 5G hotspot runs under hive-hotspot-5g (hostapd), not hive-hotspot. Check
# the actual AP interface first, then fall back to unit states.
check_hotspot() {
    local status color ap_iface ap_ip
    if [[ "$WLAN_PRESENT" -eq 0 ]]; then
        status="⭕ No WiFi (no wireless NIC)"; color="\e[0;90m"
        printf " \e[1;36m%-18s\e[0m: %b%s\e[0m\n" "WiFi Hotspot" "$color" "$status"
        return
    fi
    ap_iface=$(iw dev 2>/dev/null | awk '/Interface/{iface=$2} /type AP/{print iface; exit}')
    if [[ -n "$ap_iface" ]]; then
        ap_ip=$(ip -4 -o addr show "$ap_iface" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
        status="🟢 Running (${ap_iface}${ap_ip:+ @ $ap_ip})"; color="\e[0;92m"
    elif [[ "${_SVC_ACTIVE[hive-hotspot-5g.service]:-inactive}" == "active" ||
            "${_SVC_ACTIVE[hive-hotspot.service]:-inactive}" == "active" ]]; then
        status="🟢 Running"; color="\e[0;92m"
    elif [[ "${_SVC_ENABLED[hive-hotspot.service]:-disabled}" == "enabled" ||
            "${_SVC_ENABLED[hive-hotspot-5g.service]:-disabled}" == "enabled" ||
            -n "${WIFI_SSID_2G:-}${WIFI_SSID_5G:-}" ]]; then
        status="🟡 Stopped"; color="\e[0;93m"
    else
        status="⭕ Not configured"; color="\e[0;91m"
    fi
    printf " \e[1;36m%-18s\e[0m: %b%s\e[0m\n" "WiFi Hotspot" "$color" "$status"
}

echo ""
printf "\e[0;90m Hive Services: \x1B[0m\n"
echo ""

check_service "tailscaled"                "Tailscale VPN"        '[[ -n "${TAILSCALE_OAUTH_SECRET}" ]]'
check_provision
check_service "prometheus-node-exporter"  "Metrics Export"       "true"
check_service "ufw"                       "Firewall"             '[[ "${_SVC_ACTIVE[ufw.service]}" == "active" ]]'
check_service "fail2ban"                  "Intrusion Prevention" '[[ "${_SVC_ACTIVE[fail2ban.service]}" == "active" ]]'

[[ -n "${_SVC_ENABLED[xray.service]:-}" ]] && \
    check_service "xray"        "Xray Proxy"       '[[ -f "/etc/xray/config.json" ]]'
[[ -n "${_SVC_ENABLED[cloudflared.service]:-}" ]] && \
    check_service "cloudflared" "Cloudflare Tunnel" '[[ -n "${CF_API_TOKEN}" ]]'
[[ -n "${_SVC_ENABLED[frpc.service]:-}" ]] && \
    check_service "frpc"        "FRP Client"        '[[ -n "${FRP_SERVER_ADDR}" ]]'
[[ -n "${_SVC_ENABLED[easytier.service]:-}" ]] && \
    check_service "easytier"    "EasyTier P2P"      '[[ -n "${EASYTIER_NETWORK_NAME}" ]]'
[[ -n "${_SVC_ENABLED[hive-mihomo.service]:-}" ]] && \
    check_service "hive-mihomo" "Mihomo Gateway"    '[[ "${GATEWAY_ENABLED:-on}" != "off" ]]'
check_hotspot

# ── 等后台网络检测完成 ────────────────────────────────────
echo ""
printf "\e[0;90m Network Status: \x1B[0m\n"
echo ""

wait "${_INET_PID}" 2>/dev/null || true
if [[ "$(cat "${_TMP}/inet" 2>/dev/null)" == "connected" ]]; then
    printf " \e[1;36m%-18s\e[0m: \e[0;92m🟢 Connected\e[0m\n"    "Internet Access"
else
    printf " \e[1;36m%-18s\e[0m: \e[0;91m⭕ Disconnected\e[0m\n" "Internet Access"
fi

if [[ -n "${_TS_PID:-}" ]]; then
    wait "${_TS_PID}" 2>/dev/null || true
    if [[ "$(cat "${_TMP}/ts" 2>/dev/null)" == "connected" ]]; then
        printf " \e[1;36m%-18s\e[0m: \e[0;92m🟢 Connected\e[0m\n"    "Tailscale Network"
    else
        printf " \e[1;36m%-18s\e[0m: \e[0;91m⭕ Disconnected\e[0m\n" "Tailscale Network"
    fi
fi

rm -rf "${_TMP}"
# ──────────────────────────────────────────────────────────

# Node Identity
MAC_ADDR="${MAC:-}"
if [[ -z "$MAC_ADDR" ]]; then
    for iface_path in /sys/class/net/*; do
        [[ -e "$iface_path/device" ]] || continue
        MAC_ADDR=$(cat "$iface_path/address" 2>/dev/null)
        [[ -n "$MAC_ADDR" ]] && break
    done
fi
MAC_ADDR="${MAC_ADDR//:/}"
if [[ "$MAC_ADDR" =~ ^[[:xdigit:]]{12}$ ]]; then
    MAC6="${MAC_ADDR: -6}"
    MAC_ADDR=$(printf '%s' "$MAC_ADDR" | sed 's/../&:/g;s/:$//')
    echo ""
    printf "\e[0;90m Node Identity: \x1B[0m\n"
    echo ""
    printf " \e[1;36m%-18s\e[0m: \e[0;94m%s\e[0m\n" "MAC Address" "$MAC_ADDR"
    printf " \e[1;36m%-18s\e[0m: \e[0;94mhive-%s\e[0m\n" "Node ID" "$MAC6"
    [[ -n "${CF_DOMAIN}" ]] && \
        printf " \e[1;36m%-18s\e[0m: \e[0;94mhive-%s.%s\e[0m\n" "Public Domain" "$MAC6" "${CF_DOMAIN}"
fi
# Claim and provisioning state do not depend on discovering a physical NIC.
if [[ -s /etc/hive/claim-code ]]; then
    printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m  (客户门户 → 我的设备 → 认领设备)\n" \
        "Claim Code" "$(cat /etc/hive/claim-code)"
fi
if [[ -s /etc/hive/provision-blocked ]]; then
    printf " \e[1;31m%-18s\e[0m: \e[0;91m%s\e[0m\n" "Provisioning" "$(cat /etc/hive/provision-blocked)"
fi

# Connection Info
if [[ -f /etc/hive/node-info ]]; then

    echo ""
    printf "\e[0;90m Connection Info: \x1B[0m\n"
    echo ""

    [[ -n "${TAILSCALE_HOST:-}" ]] && \
        printf " \e[1;36m%-18s\e[0m: \e[0;93mssh root@%s\e[0m\n" "Tailscale" "${TAILSCALE_HOST}"

    [[ -n "${EASYTIER_IP:-}" ]] && \
        printf " \e[1;36m%-18s\e[0m: \e[0;93mssh root@%s\e[0m\n" "EasyTier" "${EASYTIER_IP}"

    if [[ -n "${FRP_PORT:-}" && -n "${FRP_SERVER_ADDR:-}" ]]; then
        printf " \e[1;36m%-18s\e[0m: \e[0;93mssh -p %s root@%s\e[0m\n" "FRP" "${FRP_PORT}" "${FRP_SERVER_ADDR}"
    fi

    [[ -n "${CF_URL:-}" ]] && \
        printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m\n" "CF Proxy" "${CF_URL}"

    printf " Xray (VLESS): 请从客户门户获取有效订阅链接。\n"

    # WiFi 热点（双频，仅展示已开启的频段；无无线网卡时不展示旧配置）
    if [[ "$WLAN_PRESENT" -eq 1 ]]; then
        if [[ -n "${WIFI_SSID_2G:-}" ]]; then
            printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m\n" "WiFi 2.4G (WPA2)" "${WIFI_SSID_2G}"
        fi
        if [[ -n "${WIFI_SSID_5G:-}" ]]; then
            printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m\n" "WiFi 5G (WPA3)" "${WIFI_SSID_5G}"
        fi
        if [[ -n "${WIFI_PSK:-}" && ( -n "${WIFI_SSID_2G:-}" || -n "${WIFI_SSID_5G:-}" ) ]]; then
            printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m\n" "WiFi Password" "${WIFI_PSK}"
        fi
    fi

    # 透明代理网关（仅在配置了 WAN/LAN 拓扑时展示）
    if [[ -n "${GATEWAY_WAN_IFACE:-}" || -n "${GATEWAY_LAN_IFACES:-}" ]]; then
        printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m\n" "Gateway WAN/LAN" "${GATEWAY_WAN_IFACE:-?} → ${GATEWAY_LAN_IFACES:-?}"
        if [[ -n "${GATEWAY_LAN_IP:-}" ]]; then
            printf " \e[1;36m%-18s\e[0m: \e[0;93m%s\e[0m\n" "Proxy Dashboard" "http://${GATEWAY_LAN_IP}:9090/ui"
        fi
    fi
fi

echo ""

exit 0
