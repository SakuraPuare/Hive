[Unit]
Description=First Boot Node Provisioning
# 必须等首启那一锅并发干完再跑，否则会撞进 remount r/w / 在线 resize 的窗口：
#   - systemd-remount-fs：根分区由 ro 转 r/w（约 boot+4s），早于此 /etc 不可写
#   - armbian-resize-filesystem：首启在线扩容根分区（约 boot+12s）
#   - systemd-hostnamed：设主机名走它的沙箱，FS 没稳定时它会误报 read-only
# 这些 oneshot 跑完即退/自禁用，After 不会拖慢非首启的正常启动。
After=network-online.target systemd-remount-fs.service armbian-resize-filesystem.service systemd-hostnamed.service
Wants=network-online.target
# 已跑过则标记文件存在，ConditionPathExists 取反确保不重复执行
ConditionPathExists=!/etc/hive/provisioned
# 设备开机时没有网（客户先把设备插上电、网线后接）时脚本会失败退出。没有重试的话
# 它就一直未注册，直到有人手动重启——实测这正是一次开机离线后的现象。这里让它
# 每 60s 重试直到成功；StartLimitIntervalSec=0 关掉启动频率限制，避免默认
# 5 次/10s 的策略把重试掐死。永久性失败（409 已被认领/已发证）由脚本自己写
# /etc/hive/provision-blocked 并 exit 0，不会进入这个循环。
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/bin/provision-node.sh
RemainAfterExit=no
Restart=on-failure
RestartSec=60
StandardOutput=journal+console
StandardError=journal+console
# 每个外部 API 调用都有 --max-time，脚本自身在 PROVISION_BUDGET（默认 600s）
# 处主动退出并留下诊断。systemd 只在这个守卫失效时兜底，因此留出余量：
# 全挂最坏约 780s，取 900s 保证脚本先一步给出可读的失败原因。
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
