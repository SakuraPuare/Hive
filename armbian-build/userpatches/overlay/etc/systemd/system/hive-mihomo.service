[Unit]
Description=Hive Mihomo (Clash.Meta) transparent proxy gateway
Documentation=https://github.com/SakuraPuare/hive
After=network-online.target NetworkManager.service hive-gateway-route.service
Wants=network-online.target
Requires=hive-gateway-route.service

[Service]
Type=simple
ExecCondition=/usr/local/bin/hive-gateway-prepare
ExecStart=/usr/local/bin/mihomo -d /etc/mihomo
# external-ui 指向 /var/www/metacubexd（nginx 同源托管），但 mihomo 仅信任
# 工作目录 /etc/mihomo；用官方 SAFE_PATHS 白名单放行该目录，否则启动 fatal。
Environment="SAFE_PATHS=/var/www/metacubexd"
# Subscription changes restart the service to close existing connections.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# 断网时 mihomo 会把每一次失败的外部 dial 都写一行：实测 5 分钟 37k 行 / 8.5MB
# journal（正常运行时只有 ~0.1 行/秒）。限流只在故障风暴时生效，超出部分由 journald
# 记为 "Suppressed N messages"，不会把 4GB 根分区写满。
LogRateLimitIntervalSec=30
LogRateLimitBurst=500
TimeoutStopSec=3
TimeoutStartSec=10
# TPROXY needs CAP_NET_ADMIN for transparent sockets (root runtime, bounded caps)
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
