[Unit]
Description=Hive Mihomo config sync (pull gateway config from registry -> hot reload)
After=network-online.target hive-mihomo.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/hive-clash-sync
TimeoutStartSec=30
# Independent watchdog expires authorization even if this agent hangs.
SuccessExitStatus=0
Nice=10
