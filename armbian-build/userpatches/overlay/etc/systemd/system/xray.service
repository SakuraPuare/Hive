[Unit]
Description=Xray Service (VLESS+WebSocket proxy)
After=network.target
Documentation=https://xtls.github.io
ConditionFileNotEmpty=/etc/hive/server-token

[Service]
Type=simple
User=root
ExecStartPre=/usr/local/bin/hive-xray-prepare
ExecStart=/usr/local/bin/xray run -c /etc/xray/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=3
TimeoutStartSec=10
Environment="GOGC=20"
LimitNOFILE=65535
MemoryHigh=200M
MemoryMax=300M

[Install]
WantedBy=multi-user.target
