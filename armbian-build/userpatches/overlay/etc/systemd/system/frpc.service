[Unit]
Description=FRP Client (last-resort tunnel)
After=network-online.target
Wants=network-online.target
# frpc.toml 由 provision-node.sh 渲染。工厂镜像里 frpc 是预启用的（provision 可能被跳过），
# 首启时配置还没生成：用 ConditionPathExists 干净地跳过，而不是让 ExecStartPre 空等 90s
# 后被 systemd 判超时失败（实测首启日志里就是一条 FAILED）。provision 写完配置后
# `systemctl enable --now frpc` 会正常启动。
ConditionPathExists=/etc/frp/frpc.toml

[Service]
Type=simple
ExecStart=/usr/local/bin/frpc -c /etc/frp/frpc.toml
Restart=always
RestartSec=10
# 服务端没开时 frpc 必然失败。无退避的话日志里是每 10s 一条的稳定刷屏（实测单次开机
# 84 次重启 / 98 条 failure）。指数退避到 5 分钟，服务端恢复后仍能在 ≤5 分钟内接回。
RestartSteps=5
RestartMaxDelaySec=300

[Install]
WantedBy=multi-user.target
