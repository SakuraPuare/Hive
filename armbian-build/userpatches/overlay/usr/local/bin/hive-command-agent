#!/usr/bin/env bash
# hive-command-agent —— 从 registry 拉取本节点待执行的远程命令，执行白名单动作并回传结果
#
# 工作原理：
#   1. GET /nodes/{mac}/commands（Bearer API_SECRET）→ 领取本机 pending 命令（registry 端置 sent）
#   2. 对每条命令按 action 白名单映射到具体 systemctl/reboot 调用
#   3. POST /nodes/{mac}/commands/{id}/ack 回传 done/failed + 结果文本
#   4. reboot 特殊处理：先 ACK done 再关机（否则重启后命令仍是 sent，且无法回传）
#
# 由 hive-command-agent.timer 每 ~60s 触发。所有失败都不致命（下轮重试）。
# 安全：action 白名单在 registry 端和此处双重校验，未知 action 一律 failed 且不执行任何命令。
set -uo pipefail

CONFIG_ENV="/etc/hive/config.env"
NODE_INFO="/etc/hive/node-info"

log() { echo "[hive-command-agent] $*"; logger -t "hive-command-agent" "$*" 2>/dev/null || true; }

[ -f "${CONFIG_ENV}" ] && source "${CONFIG_ENV}" 2>/dev/null
[ ! -s /etc/hive/device-token ] || NODE_REGISTRY_API_SECRET=$(cat /etc/hive/device-token)
source /usr/local/bin/hive-node-info
hive_load_node_info "$NODE_INFO"

if [ -z "${NODE_REGISTRY_URL:-}" ]; then log "NODE_REGISTRY_URL 未配置，跳过"; exit 0; fi
if [ -z "${NODE_REGISTRY_API_SECRET:-}" ]; then log "API_SECRET 未配置，跳过"; exit 0; fi
if [ -z "${MAC:-}" ]; then log "MAC 未知（node-info 缺失），跳过"; exit 0; fi

MAC_NORM=$(echo "${MAC}" | tr 'A-F' 'a-f' | tr -cd 'a-f0-9')
MAC_NORM="${MAC_NORM: -12}"
AUTH="Authorization: Bearer ${NODE_REGISTRY_API_SECRET}"
BASE="${NODE_REGISTRY_URL}/nodes/${MAC_NORM}/commands"

# ── 领取待执行命令 ─────────────────────────────────────────────────────
# -4 强制 IPv4：避开 IPv6+Mihomo 半开死路（详见 provision-node.sh 注册段注释）。
RESP=$(curl -4 -sf --max-time 15 -H "${AUTH}" "${BASE}" 2>/dev/null) || { log "拉取命令失败（registry 不可达？）"; exit 0; }
[ -z "${RESP}" ] || [ "${RESP}" = "[]" ] && exit 0
command -v jq >/dev/null 2>&1 || { log "缺 jq，无法解析命令"; exit 0; }

# ack <id> <status> <result>
ack() {
    local id="$1" status="$2" result="$3"
    curl -4 -sf --max-time 15 -H "${AUTH}" -H "Content-Type: application/json" \
        -d "$(jq -n --arg s "$status" --arg r "$result" '{status:$s,result:$r}')" \
        "${BASE}/${id}/ack" >/dev/null 2>&1 \
        && log "已回传 #${id} ${status}" || log "回传 #${id} 失败（下轮由 registry 端超时兜底）"
}

# 逐条执行。jq -c 每行一个对象，避免命令里空格/换行破坏循环。
echo "${RESP}" | jq -c '.[]' 2>/dev/null | while read -r cmd; do
    id=$(echo "$cmd" | jq -r '.id')
    action=$(echo "$cmd" | jq -r '.action')
    [ -z "$id" ] || [ "$id" = "null" ] && continue
    log "执行命令 #${id}: ${action}"
    case "$action" in
        reboot)
            # 先 ACK 再重启：重启后无法回传，且命令会永远卡 sent。
            ack "$id" "done" "rebooting"
            sleep 1
            systemctl reboot || reboot
            ;;
        restart-xray)
            out=$(systemctl restart xray 2>&1) \
                && ack "$id" "done" "xray restarted" \
                || ack "$id" "failed" "${out:0:900}"
            ;;
        restart-mihomo)
            out=$(systemctl restart hive-mihomo 2>&1) \
                && ack "$id" "done" "hive-mihomo restarted" \
                || ack "$id" "failed" "${out:0:900}"
            ;;
        resync)
            out=$( { /usr/local/bin/hive-xray-sync; /usr/local/bin/hive-clash-sync; } 2>&1 ) \
                && ack "$id" "done" "resynced xray+clash" \
                || ack "$id" "failed" "${out:0:900}"
            ;;
        service-control)
            # params 是 JSON: {"service":"xray","operation":"restart"}
            svc=$(echo "$cmd" | jq -r '.params' | jq -r '.service // empty' 2>/dev/null)
            op=$(echo "$cmd" | jq -r '.params' | jq -r '.operation // empty' 2>/dev/null)
            case "$svc" in
                xray|xray-exporter|cloudflared|frpc|easytier|hive-mihomo|hive-hotspot|hive-gateway|hive-firewall|hive-fail2ban|nginx|tailscaled|warp-svc|hive-xray-sync.timer|hive-clash-sync.timer|hive-command-agent.timer|hive-updater.timer)
                    ;;
                *) ack "$id" "failed" "unsupported service: ${svc}"; continue ;;
            esac
            case "$op" in
                start|stop|restart|status)
                    ;;
                *) ack "$id" "failed" "unsupported operation: ${op}"; continue ;;
            esac
            if [ "$op" = "status" ]; then
                out=$(systemctl is-active "$svc" 2>&1 || true)
                ack "$id" "done" "${svc} status: ${out:0:850}"
            else
                out=$(systemctl "$op" "$svc" 2>&1) \
                    && ack "$id" "done" "${svc} ${op}: ${out:0:850}" \
                    || ack "$id" "failed" "${svc} ${op}: ${out:0:850}"
            fi
            ;;
        hotspot-config)
            # params 是 JSON：可选 ssid2g/ssid5g/psk/country/channel5g/width5g/preferBand。
            # 只写入专用 hotspot.env，避免修改包含设备凭证的 config.env。
            hs_ssid2g=$(echo "$cmd" | jq -r '.params' | jq -r '.ssid2g // empty' 2>/dev/null)
            hs_ssid5g=$(echo "$cmd" | jq -r '.params' | jq -r '.ssid5g // empty' 2>/dev/null)
            hs_psk=$(echo "$cmd" | jq -r '.params' | jq -r '.psk // empty' 2>/dev/null)
            hs_country=$(echo "$cmd" | jq -r '.params' | jq -r '.country // empty' 2>/dev/null)
            hs_channel=$(echo "$cmd" | jq -r '.params' | jq -r '.channel5g // empty' 2>/dev/null)
            hs_width=$(echo "$cmd" | jq -r '.params' | jq -r '.width5g // empty' 2>/dev/null)
            hs_prefer=$(echo "$cmd" | jq -r '.params' | jq -r '.preferBand // empty' 2>/dev/null)
            valid_printable() {
                local value="$1" min="$2" max="$3" length
                length=${#value}
                [ -z "$value" ] && return 0
                [ "$length" -ge "$min" ] && [ "$length" -le "$max" ] || return 1
                LC_ALL=C printf '%s' "$value" | LC_ALL=C grep -Eq '^[ -~]+$'
            }
            valid_country() { [ -z "$1" ] || [[ "$1" =~ ^[A-Za-z]{2}$ ]]; }
            valid_channel() { [ -z "$1" ] || case "$1" in 36|40|44|48|52|56|60|64|100|104|108|112|116|120|124|128|132|136|140|144|149|153|157|161|165) return 0;; *) return 1;; esac; }
            valid_width() { [ -z "$1" ] || case "$1" in 20|40|80) return 0;; *) return 1;; esac; }
            valid_prefer() { [ -z "$1" ] || case "$1" in 5|2.4) return 0;; *) return 1;; esac; }
            if ! valid_printable "$hs_ssid2g" 1 32 || ! valid_printable "$hs_ssid5g" 1 32 ||
                ! valid_printable "$hs_psk" 8 63 ||
                ! valid_country "$hs_country" || ! valid_channel "$hs_channel" ||
                ! valid_width "$hs_width" || ! valid_prefer "$hs_prefer"; then
                ack "$id" "failed" "invalid hotspot config"
                continue
            fi
            hs_tmp=$(mktemp /etc/hive/hotspot.env.XXXXXX 2>/dev/null) || {
                ack "$id" "failed" "cannot create hotspot config"
                continue
            }
            umask 077
            write_ok=0
            {
                printf 'HOTSPOT_SSID_2G=%q\n' "$hs_ssid2g"
                printf 'HOTSPOT_SSID_5G=%q\n' "$hs_ssid5g"
                printf 'HOTSPOT_PSK=%q\n' "$hs_psk"
                printf 'HOTSPOT_COUNTRY=%q\n' "${hs_country^^}"
                printf 'HOTSPOT_5G_CHANNEL=%q\n' "$hs_channel"
                printf 'HOTSPOT_5G_WIDTH=%q\n' "$hs_width"
                printf 'HOTSPOT_PREFER_BAND=%q\n' "$hs_prefer"
            } > "$hs_tmp" && chmod 600 "$hs_tmp" && chown root:root "$hs_tmp" &&
                mv -f "$hs_tmp" /etc/hive/hotspot.env && write_ok=1
            if [ "$write_ok" -ne 1 ] || ! /usr/local/bin/hive-hotspot.sh >/tmp/hive-hotspot-config.$$ 2>&1; then
                out=$(tail -c 850 /tmp/hive-hotspot-config.$$ 2>/dev/null)
                rm -f /tmp/hive-hotspot-config.$$ "$hs_tmp"
                ack "$id" "failed" "hotspot apply failed: ${out}"
            else
                out=$(tail -c 850 /tmp/hive-hotspot-config.$$ 2>/dev/null)
                rm -f /tmp/hive-hotspot-config.$$
                ack "$id" "done" "hotspot config applied: ${out}"
            fi
            ;;
        *)
            # 未知 action：不执行任何命令，直接 failed（防越权 / 陈旧客户端）。
            ack "$id" "failed" "unsupported action: ${action}"
            ;;
    esac
done

exit 0
