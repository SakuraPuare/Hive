#!/usr/bin/env bash
# hive-command-agent —— 从 registry 拉取本节点待执行的远程命令，执行白名单动作并回传结果
#
# 工作原理：
#   1. GET /nodes/{mac}/commands（Bearer API_SECRET）→ 领取本机 pending 命令（registry 端置 sent）
#   2. 对每条命令按 action 白名单映射到具体 systemctl/reboot 调用
#   3. POST /nodes/{mac}/commands/{id}/ack 回传 done/failed + 结果文本
#   4. reboot 特殊处理：先 ACK done 再关机（否则重启后命令仍是 sent，且无法回传）
#
# 由 hive-command-agent.timer 每 ~60s 触发。所有失败都不致命（下轮重试）。
# 安全：action 白名单在 registry 端和此处双重校验，未知 action 一律 failed 且不执行任何命令。
set -uo pipefail

CONFIG_ENV="/etc/hive/config.env"
NODE_INFO="/etc/hive/node-info"

log() { echo "[hive-command-agent] $*"; logger -t "hive-command-agent" "$*" 2>/dev/null || true; }

[ -f "${CONFIG_ENV}" ] && source "${CONFIG_ENV}" 2>/dev/null
[ ! -s /etc/hive/device-token ] || NODE_REGISTRY_API_SECRET=$(cat /etc/hive/device-token)
source /usr/local/bin/hive-node-info
hive_load_node_info "$NODE_INFO"

if [ -z "${NODE_REGISTRY_URL:-}" ]; then log "NODE_REGISTRY_URL 未配置，跳过"; exit 0; fi
if [ -z "${NODE_REGISTRY_API_SECRET:-}" ]; then log "API_SECRET 未配置，跳过"; exit 0; fi
if [ -z "${MAC:-}" ]; then log "MAC 未知（node-info 缺失），跳过"; exit 0; fi

MAC_NORM=$(echo "${MAC}" | tr 'A-F' 'a-f' | tr -cd 'a-f0-9')
MAC_NORM="${MAC_NORM: -12}"
AUTH="Authorization: Bearer ${NODE_REGISTRY_API_SECRET}"
BASE="${NODE_REGISTRY_URL}/nodes/${MAC_NORM}/commands"

# One whitelist for status snapshots and remote service-control operations.
SERVICES=(xray xray-exporter cloudflared frpc easytier hive-mihomo hive-hotspot
    hive-gateway hive-firewall hive-fail2ban nginx tailscaled warp-svc
    hive-xray-sync.timer hive-clash-sync.timer hive-command-agent.timer hive-updater.timer)

supported_service() {
    local name
    for name in "${SERVICES[@]}"; do [ "$name" != "$1" ] || return 0; done
    return 1
}

hotspot_2g_active() {
    command -v nmcli >/dev/null 2>&1 || return 1
    timeout 2 nmcli -t -f NAME connection show --active 2>/dev/null | grep -qx hive-hotspot-2g
}

hotspot_5g_active() {
    local state
    state=$(timeout 2 systemctl show hive-hotspot-5g --property=ActiveState 2>/dev/null || true)
    printf '%s\n' "$state" | grep -qx 'ActiveState=active'
}

service_states() {
    local svc out key value active sub load state
    for svc in "${SERVICES[@]}"; do
        if [ "$svc" = "hive-gateway" ]; then
            # The gateway unit is a one-shot configurator. Report whether the
            # gateway is actually configured; on hotspot-only topology it is
            # intentionally not applicable rather than a dead service.
            if grep -qE '^GATEWAY_(LAN_IP|ONE_ARM_IFACE)=.' "$NODE_INFO" 2>/dev/null; then
                printf '%s\t%s\t%s\t%s\n' "$svc" active running loaded
            elif iw dev 2>/dev/null | grep -q 'type AP'; then
                printf '%s\t%s\t%s\t%s\n' "$svc" inactive not-applicable loaded
            else
                printf '%s\t%s\t%s\t%s\n' "$svc" inactive dead loaded
            fi
            continue
        fi
        if [ "$svc" = "hive-hotspot" ]; then
            # One logical service covers the 2.4G NetworkManager AP and the
            # 5G hostapd unit; the configurator oneshot itself exits normally.
            if hotspot_5g_active || hotspot_2g_active; then
                printf '%s\t%s\t%s\t%s\n' "$svc" active running loaded
            else
                state=$(timeout 2 systemctl show hive-hotspot-5g --property=ActiveState 2>/dev/null || true)
                if printf '%s\n' "$state" | grep -qx 'ActiveState=failed'; then
                    printf '%s\t%s\t%s\t%s\n' "$svc" failed failed loaded
                else
                    printf '%s\t%s\t%s\t%s\n' "$svc" inactive dead loaded
                fi
            fi
            continue
        fi
        active=unknown sub=unknown load=unknown
        out=$(timeout 2 systemctl show "$svc" --property=LoadState,ActiveState,SubState 2>/dev/null || true)
        while IFS='=' read -r key value; do
            [ -n "$value" ] || continue
            case "$key" in
                ActiveState) active=$value ;;
                SubState) sub=$value ;;
                LoadState) load=$value ;;
            esac
        done <<< "$out"
        if [ "$load" = "not-found" ]; then active=not-found sub=not-found; fi
        printf '%s\t%s\t%s\t%s\n' "$svc" "$active" "$sub" "$load"
    done | jq -Rsc 'split("\n") | map(select(length > 0) | split("\t") | {name:.[0],active_state:.[1],sub_state:.[2],load_state:.[3]})'
}

# Physical interface addresses and the node's observed HTTPS request path.
# Per-family success timestamps survive failed refreshes; retry at most hourly.
address_snapshot() {
    python3 - <<'PY'
import datetime, ipaddress, json, pathlib, re, subprocess, time
cache_path = pathlib.Path('/var/lib/hive/egress-addresses.json')
now = int(time.time())
def stamp(epoch):
    return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
def valid(raw, family=None, public=False):
    try:
        ip = ipaddress.ip_address(raw)
        if '%' in raw or ip.is_loopback or ip.is_link_local or ip.is_multicast or ip.is_unspecified:
            return None
        if ip.version == 6 and ip.ipv4_mapped is not None:
            return None
        if ip.version == 4 and ip in ipaddress.ip_network('198.18.0.0/15'):
            return None
        if family and ip.version != family or public and not ip.is_global:
            return None
        return str(ip)
    except (ValueError, TypeError):
        return None
lan = []
collection_ok = False
hotspot_capable = False
try:
    rows = json.loads(subprocess.check_output(['ip', '-j', 'address', 'show'], timeout=3))
    if not isinstance(rows, list):
        raise ValueError('invalid address list')
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get('addr_info', []), list):
            raise ValueError('invalid interface data')
        iface = row.get('ifname', '')
        physical = pathlib.Path('/sys/class/net', iface, 'device').exists()
        wireless = pathlib.Path('/sys/class/net', iface, 'phy80211').exists()
        if not re.fullmatch(r'[A-Za-z0-9_.-]{1,15}', iface) or not (physical or wireless):
            continue
        for entry in row.get('addr_info', []):
            if not isinstance(entry, dict):
                raise ValueError('invalid address data')
            address = valid(entry.get('local', ''))
            prefix = entry.get('prefixlen')
            if address and type(prefix) is int and 0 <= prefix <= (32 if ':' not in address else 128):
                item = {'interface': iface, 'address': address, 'prefix_length': prefix}
                if item not in lan:
                    lan.append(item)
    # Only main-table physical default devices identify uplinks; overlay/TUN
    # policy routes do not. Failed route inspection leaves the role unknown.
    uplinks = set()
    routes_ok = True
    for family in ('-4', '-6'):
        try:
            routes = json.loads(subprocess.check_output(['ip', family, '-j', 'route', 'show', 'table', 'main', 'default'], timeout=3))
            if not isinstance(routes, list) or any(not isinstance(route, dict) for route in routes):
                raise ValueError('invalid route list')
            for route in routes:
                dev = route.get('dev')
                if isinstance(dev, str):
                    uplinks.add(dev)
                for hop in route.get('nexthops', []):
                    if isinstance(hop, dict) and isinstance(hop.get('dev'), str):
                        uplinks.add(hop['dev'])
        except (OSError, ValueError, TypeError, subprocess.SubprocessError):
            routes_ok = False
    # Report AP capability independently of the current hotspot state so a
    # newly added wireless adapter makes hotspot configuration available.
    hotspot_capable = False
    wireless_seen = False
    modes_read = False
    net_root = pathlib.Path('/sys/class/net')
    for iface_dir in (net_root.iterdir() if net_root.exists() else ()):
        phy = iface_dir / 'phy80211'
        if not phy.exists():
            continue
        wireless_seen = True
        try:
            phy_name = phy.resolve().name
            info = subprocess.check_output(['iw', 'phy', phy_name, 'info'], timeout=2).decode()
        except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
            continue
        modes_read = True
        if re.search(r'^\s*\*\s*AP(?:/VLAN)?\s*$', info, re.M):
            hotspot_capable = True
            break
    if not hotspot_capable and wireless_seen and not modes_read:
        # iw could not enumerate modes; a present wireless NIC is the best
        # available signal that the user can configure a hotspot.
        hotspot_capable = True
    # Wireless is AP-only on Hive. Only interfaces iw reports as type AP (2.4G/5G
    # and virtual AP interfaces, no board-specific addresses) are kept, as
    # hotspot; station/monitor or unreadable-mode wireless interfaces are not
    # part of the customer topology and must not become panel candidates.
    ap_interfaces = set()
    for iface in {item['interface'] for item in lan}:
        if not pathlib.Path('/sys/class/net', iface, 'phy80211').exists():
            continue
        try:
            info = subprocess.check_output(['iw', 'dev', iface, 'info'], timeout=2).decode()
        except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
            continue
        if re.search(r'^\s*type\s+AP\s*$', info, re.M):
            ap_interfaces.add(iface)
    lan = [item for item in lan if item['interface'] in ap_interfaces
           or not pathlib.Path('/sys/class/net', item['interface'], 'phy80211').exists()][:32]
    for item in lan:
        if item['interface'] in ap_interfaces:
            item['role'] = 'hotspot'
        elif routes_ok:
            item['role'] = 'wan' if item['interface'] in uplinks else 'lan'
    collection_ok = True
except (OSError, ValueError, TypeError, subprocess.SubprocessError):
    pass
try:
    cache = json.loads(cache_path.read_text())
    if not isinstance(cache, dict): cache = {}
except (OSError, ValueError):
    cache = {}
country = ''
for family in (4, 6):
    key = str(family)
    prior = cache.get(key, {})
    if not isinstance(prior, dict): prior = {}
    address = valid(prior.get('ip', ''), family, True)
    success = prior.get('success', 0)
    attempt = prior.get('attempt', 0)
    if type(success) is not int or not 0 < success <= now or not address:
        prior.pop('ip', None); prior.pop('success', None)
    if type(attempt) is not int or not 0 <= now - attempt < 3600:
        prior['attempt'] = now
        try:
            trace = subprocess.check_output(['curl', '-'+key, '--noproxy', '*', '-fsS', '--max-time', '4', '--max-filesize', '4096', 'https://www.cloudflare.com/cdn-cgi/trace'], timeout=5, stderr=subprocess.DEVNULL).decode()
            fields = dict(line.split('=', 1) for line in trace.splitlines() if '=' in line)
            ip = valid(fields.get('ip', ''), family, True)
            if ip:
                prior.update(ip=ip, success=now)
            if family == 4 and re.fullmatch('[A-Z]{2}', fields.get('loc', '')):
                country = fields['loc']
        except (OSError, ValueError, UnicodeError, subprocess.SubprocessError):
            pass
    cache[key] = prior
try:
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    temp = cache_path.with_suffix('.tmp')
    temp.write_text(json.dumps(cache)); temp.replace(cache_path)
except OSError:
    pass
times = [cache[str(f)]['success'] for f in (4, 6) if cache[str(f)].get('ip')]
print(json.dumps({'collection_ok': collection_ok, 'lan': lan, 'hotspot_capable': hotspot_capable, 'egress': {'ipv4': cache['4'].get('ip', ''), 'ipv6': cache['6'].get('ip', ''), 'sampled_at': stamp(min(times)) if times else None}, 'country': country}))
PY
}

# ── 心跳 ───────────────────────────────────────────────────────────────
# 面板上的"在线"和 CPU/内存/磁盘曲线全靠它（registry 写 last_seen + node_status_checks）。
# 放在拉命令之前：命令通道故障不应让节点显示离线。所有取数失败都退化成 0，绝不致命。
# registry 用这个国家判断 gateway_direction=auto（大陆 → 出海，境外 → 回国）。
# country 每天更新一次；复用本轮出口 trace 的 loc，失败退回 ipinfo。
# 出口 trace 自身每小时刷新，国家缓存仍保持原有一天周期。
COUNTRY_CACHE="/var/lib/hive/country"
country_code() {
    local now mtime c
    now=$(date +%s)
    mtime=$(stat -c %Y "${COUNTRY_CACHE}" 2>/dev/null || echo 0)
    if [ -s "${COUNTRY_CACHE}" ] && [ $(( now - mtime )) -lt 86400 ]; then
        tr -d '\r\n' < "${COUNTRY_CACHE}"; return 0
    fi
    c=${TRACE_COUNTRY:-}
    case "${c}" in
        [A-Z][A-Z]) ;;
        *) c=$(curl -4 -s --max-time 4 https://ipinfo.io/country 2>/dev/null | tr -d '\r\n') ;;
    esac
    case "${c}" in
        [A-Z][A-Z]) mkdir -p "$(dirname "${COUNTRY_CACHE}")" 2>/dev/null
                    printf '%s' "${c}" > "${COUNTRY_CACHE}" 2>/dev/null
                    printf '%s' "${c}" ;;
        *) : ;;
    esac
}

heartbeat() {
    [ -r /proc/uptime ] || return 0
    local up cpu=0 mem=0 disk=0 total avail country services addresses TRACE_COUNTRY
    read -r up _ < /proc/uptime || up=0
    up=${up%.*}
    total=$(awk '/^MemTotal:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
    avail=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
    [ "${total:-0}" -gt 0 ] 2>/dev/null && mem=$(( (total - ${avail:-0}) * 100 / total ))
    disk=$(df -P / 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}' || echo 0)
    disk=${disk:-0}
    # /proc/stat 两次采样（1s）算 CPU 占用；timer 每分钟才跑一次，1s 可接受。
    local u1 n1 s1 i1 w1 ir1 si1 st1 u2 n2 s2 i2 w2 ir2 si2 st2 dtotal didle
    if read -r _ u1 n1 s1 i1 w1 ir1 si1 st1 _ < /proc/stat 2>/dev/null; then
        sleep 1
        if read -r _ u2 n2 s2 i2 w2 ir2 si2 st2 _ < /proc/stat 2>/dev/null; then
            dtotal=$(( (u2+n2+s2+i2+w2+ir2+si2+st2) - (u1+n1+s1+i1+w1+ir1+si1+st1) ))
            didle=$(( (i2+w2) - (i1+w1) ))
            [ "$dtotal" -gt 0 ] && cpu=$(( (dtotal - didle) * 100 / dtotal ))
        fi
    fi
    addresses=$(address_snapshot)
    TRACE_COUNTRY=$(jq -r '.country // empty' <<< "$addresses")
    addresses=$(jq -c 'if .collection_ok == true then del(.country, .collection_ok) else null end' <<< "$addresses")
    country=$(country_code)
    services=$(service_states)
    curl -4 -sf --max-time 10 -H "${AUTH}" -H 'Content-Type: application/json' \
        -d "$(jq -nc --arg mac "${MAC_NORM}" --argjson cpu "${cpu:-0}" --argjson mem "${mem:-0}" \
              --argjson disk "${disk:-0}" --argjson up "${up:-0}" --arg country "${country:-}" \
              --argjson services "$services" --argjson addresses "${addresses:-null}" \
              '{mac:$mac,cpu_pct:$cpu,mem_pct:$mem,disk_pct:$disk,uptime_sec:$up,services:$services} + (if $addresses == null then {} else {addresses:$addresses} end) + (if $country == "" then {} else {country:$country} end)')" \
        "${NODE_REGISTRY_URL}/nodes/heartbeat" >/dev/null 2>&1 \
        && log "heartbeat ok (cpu=${cpu}% mem=${mem}% disk=${disk}%)" \
        || log "heartbeat failed（registry 不可达，下轮重试）"
}
heartbeat

# ── 领取待执行命令 ─────────────────────────────────────────────────────
# -4 强制 IPv4：避开 IPv6+Mihomo 半开死路（详见 provision-node.sh 注册段注释）。
RESP=$(curl -4 -sf --max-time 15 -H "${AUTH}" "${BASE}" 2>/dev/null) || { log "拉取命令失败（registry 不可达？）"; exit 0; }
[ -z "${RESP}" ] || [ "${RESP}" = "[]" ] && exit 0
command -v jq >/dev/null 2>&1 || { log "缺 jq，无法解析命令"; exit 0; }

# ack <id> <status> <result>
ack() {
    local id="$1" status="$2" result="$3"
    curl -4 -sf --max-time 15 -H "${AUTH}" -H "Content-Type: application/json" \
        -d "$(jq -n --arg s "$status" --arg r "$result" '{status:$s,result:$r}')" \
        "${BASE}/${id}/ack" >/dev/null 2>&1 \
        && log "已回传 #${id} ${status}" || log "回传 #${id} 失败（下轮由 registry 端超时兜底）"
}

# 逐条执行。jq -c 每行一个对象，避免命令里空格/换行破坏循环。
echo "${RESP}" | jq -c '.[]' 2>/dev/null | while read -r cmd; do
    id=$(echo "$cmd" | jq -r '.id')
    action=$(echo "$cmd" | jq -r '.action')
    [ -z "$id" ] || [ "$id" = "null" ] && continue
    log "执行命令 #${id}: ${action}"
    case "$action" in
        reboot)
            # 先 ACK 再重启：重启后无法回传，且命令会永远卡 sent。
            ack "$id" "done" "rebooting"
            sleep 1
            systemctl reboot || reboot
            ;;
        restart-xray)
            out=$(systemctl restart xray 2>&1) \
                && ack "$id" "done" "xray restarted" \
                || ack "$id" "failed" "${out:0:900}"
            ;;
        restart-mihomo)
            out=$(systemctl restart hive-mihomo 2>&1) \
                && ack "$id" "done" "hive-mihomo restarted" \
                || ack "$id" "failed" "${out:0:900}"
            ;;
        resync)
            out=$( { /usr/local/bin/hive-xray-sync; /usr/local/bin/hive-clash-sync; } 2>&1 ) \
                && ack "$id" "done" "resynced xray+clash" \
                || ack "$id" "failed" "${out:0:900}"
            ;;
        service-control)
            # params 是 JSON: {"service":"xray","operation":"restart"}
            svc=$(echo "$cmd" | jq -r '.params' | jq -r '.service // empty' 2>/dev/null)
            op=$(echo "$cmd" | jq -r '.params' | jq -r '.operation // empty' 2>/dev/null)
            if ! supported_service "$svc"; then
                ack "$id" "failed" "unsupported service: ${svc}"
                continue
            fi
            case "$op" in
                start|stop|restart|status)
                    ;;
                *) ack "$id" "failed" "unsupported operation: ${op}"; continue ;;
            esac
            if [ "$svc" = "hive-hotspot" ]; then
                case "$op" in
                    status)
                        five=$(timeout 3 systemctl show hive-hotspot-5g --property=ActiveState 2>/dev/null | sed -n 's/^ActiveState=//p' | head -1 || true)
                        five=${five:-unknown}
                        if hotspot_2g_active; then two=active; else two=inactive; fi
                        ack "$id" "done" "hive-hotspot status: 5g=${five} 2g=${two}"
                        ;;
                    stop)
                        out=$( { systemctl stop hive-hotspot-5g 2>&1; systemctl stop hive-hotspot-5g-dnsmasq 2>&1; if command -v nmcli >/dev/null 2>&1; then nmcli connection down hive-hotspot-2g 2>&1 || true; fi; } )
                        if hotspot_5g_active || hotspot_2g_active; then
                            ack "$id" "failed" "hive-hotspot stop: ${out:0:850}"
                        else
                            ack "$id" "done" "hive-hotspot stopped: ${out:0:850}"
                        fi
                        ;;
                    start|restart)
                        if [ ! -x /usr/local/bin/hive-hotspot.sh ]; then
                            ack "$id" "failed" "hive-hotspot script missing"
                            continue
                        fi
                        out=$(timeout 90 /usr/local/bin/hive-hotspot.sh 2>&1)
                        rc=$?
                        if [ "$rc" -ne 0 ]; then
                            ack "$id" "failed" "hive-hotspot ${op} (exit ${rc}): ${out:0:850}"
                        else
                            ack "$id" "done" "hive-hotspot ${op}: ${out:0:850}"
                        fi
                        ;;
                esac
                continue
            fi
            if [ "$op" = "status" ]; then
                # Inactive/missing units return 3/4; timeout or execution errors
                # are failures, not successful status observations.
                out=$(SYSTEMD_COLORS=0 timeout 5 systemctl status "$svc" --no-pager --full --lines=5 2>&1 | { head -c 850; cat >/dev/null; })
                status_rc=$?
                case "$status_rc" in
                    0|3|4) ack "$id" "done" "${svc} status: ${out}" ;;
                    *) ack "$id" "failed" "${svc} status (exit ${status_rc}): ${out}" ;;
                esac
            else
                out=$(systemctl "$op" "$svc" 2>&1) \
                    && ack "$id" "done" "${svc} ${op}: ${out:0:850}" \
                    || ack "$id" "failed" "${svc} ${op}: ${out:0:850}"
            fi
            ;;
        hotspot-config)
            # params 是 JSON：可选 ssid2g/ssid5g/psk/country/channel5g/width5g/preferBand。
            # 只写入专用 hotspot.env，避免修改包含设备凭证的 config.env。
            hs_ssid2g=$(echo "$cmd" | jq -r '.params' | jq -r '.ssid2g // empty' 2>/dev/null)
            hs_ssid5g=$(echo "$cmd" | jq -r '.params' | jq -r '.ssid5g // empty' 2>/dev/null)
            hs_psk=$(echo "$cmd" | jq -r '.params' | jq -r '.psk // empty' 2>/dev/null)
            hs_country=$(echo "$cmd" | jq -r '.params' | jq -r '.country // empty' 2>/dev/null)
            hs_channel=$(echo "$cmd" | jq -r '.params' | jq -r '.channel5g // empty' 2>/dev/null)
            hs_width=$(echo "$cmd" | jq -r '.params' | jq -r '.width5g // empty' 2>/dev/null)
            hs_prefer=$(echo "$cmd" | jq -r '.params' | jq -r '.preferBand // empty' 2>/dev/null)
            valid_printable() {
                local value="$1" min="$2" max="$3" length
                length=${#value}
                [ -z "$value" ] && return 0
                [ "$length" -ge "$min" ] && [ "$length" -le "$max" ] || return 1
                LC_ALL=C printf '%s' "$value" | LC_ALL=C grep -Eq '^[ -~]+$'
            }
            valid_country() { [ -z "$1" ] || [[ "$1" =~ ^[A-Za-z]{2}$ ]]; }
            valid_channel() { [ -z "$1" ] || case "$1" in 36|40|44|48|52|56|60|64|100|104|108|112|116|120|124|128|132|136|140|144|149|153|157|161|165) return 0;; *) return 1;; esac; }
            valid_width() { [ -z "$1" ] || case "$1" in 20|40|80) return 0;; *) return 1;; esac; }
            valid_prefer() { [ -z "$1" ] || case "$1" in 5|2.4) return 0;; *) return 1;; esac; }
            if ! valid_printable "$hs_ssid2g" 1 32 || ! valid_printable "$hs_ssid5g" 1 32 ||
                ! valid_printable "$hs_psk" 8 63 ||
                ! valid_country "$hs_country" || ! valid_channel "$hs_channel" ||
                ! valid_width "$hs_width" || ! valid_prefer "$hs_prefer"; then
                ack "$id" "failed" "invalid hotspot config"
                continue
            fi
            hs_tmp=$(mktemp /etc/hive/hotspot.env.XXXXXX 2>/dev/null) || {
                ack "$id" "failed" "cannot create hotspot config"
                continue
            }
            umask 077
            write_ok=0
            {
                printf 'HOTSPOT_SSID_2G=%q\n' "$hs_ssid2g"
                printf 'HOTSPOT_SSID_5G=%q\n' "$hs_ssid5g"
                printf 'HOTSPOT_PSK=%q\n' "$hs_psk"
                printf 'HOTSPOT_COUNTRY=%q\n' "${hs_country^^}"
                printf 'HOTSPOT_5G_CHANNEL=%q\n' "$hs_channel"
                printf 'HOTSPOT_5G_WIDTH=%q\n' "$hs_width"
                printf 'HOTSPOT_PREFER_BAND=%q\n' "$hs_prefer"
            } > "$hs_tmp" && chmod 600 "$hs_tmp" && chown root:root "$hs_tmp" &&
                mv -f "$hs_tmp" /etc/hive/hotspot.env && write_ok=1
            if [ "$write_ok" -ne 1 ] || ! /usr/local/bin/hive-hotspot.sh >/tmp/hive-hotspot-config.$$ 2>&1; then
                out=$(tail -c 850 /tmp/hive-hotspot-config.$$ 2>/dev/null)
                rm -f /tmp/hive-hotspot-config.$$ "$hs_tmp"
                ack "$id" "failed" "hotspot apply failed: ${out}"
            else
                out=$(tail -c 850 /tmp/hive-hotspot-config.$$ 2>/dev/null)
                rm -f /tmp/hive-hotspot-config.$$
                ack "$id" "done" "hotspot config applied: ${out}"
            fi
            ;;
        ota-update)
            # params 是 JSON: {"url":"...","sha256":"...","version":"...","force":false}
            ota_url=$(echo "$cmd" | jq -r '.params' | jq -r '.url // empty' 2>/dev/null)
            ota_sha=$(echo "$cmd" | jq -r '.params' | jq -r '.sha256 // empty' 2>/dev/null)
            ota_ver=$(echo "$cmd" | jq -r '.params' | jq -r '.version // empty' 2>/dev/null)
            ota_force=$(echo "$cmd" | jq -r '.params' | jq -r '.force // false' 2>/dev/null)
            if [ -z "$ota_url" ] || [ -z "$ota_sha" ]; then
                ack "$id" "failed" "missing url or sha256 in params"
            else
                ota_args=(--url "$ota_url" --sha256 "$ota_sha")
                [ -n "$ota_ver" ] && ota_args+=(--version "$ota_ver")
                [ "$ota_force" = "true" ] && ota_args+=(--force)
                out=$(/usr/local/bin/hive-updater "${ota_args[@]}" 2>&1) \
                    && ack "$id" "done" "${out:0:900}" \
                    || ack "$id" "failed" "${out:0:900}"
            fi
            ;;
        *)
            # 未知 action：不执行任何命令，直接 failed（防越权 / 陈旧客户端）。
            ack "$id" "failed" "unsupported action: ${action}"
            ;;
    esac
done

exit 0
