#!/usr/bin/env bash
# Shared by sync agents, service startup hooks and the independent watchdog.
HIVE_ACCESS_DIR=/run/hive-subscriptions
HIVE_TRAFFIC_DIR=/var/lib/hive/traffic-pending
HIVE_TRAFFIC_GENERATION=/var/lib/hive/traffic-generation.json
mkdir -p "$HIVE_ACCESS_DIR" "$HIVE_TRAFFIC_DIR"
chmod 700 "$HIVE_ACCESS_DIR" "$HIVE_TRAFFIC_DIR"
hive_now() { awk '{print int($1)}' /proc/uptime; }
hive_lease_valid() {
    local deadline
    read -r deadline < "$HIVE_ACCESS_DIR/$1.lease" 2>/dev/null || return 1
    [[ "$deadline" =~ ^[0-9]+$ ]] && [ "$(hive_now)" -lt "$deadline" ]
}
hive_lease_write() {
    local role=$1 start=$2 seconds=$3 deadline
    [[ "$seconds" =~ ^[0-9]+$ ]] && [ "$seconds" -ge 1 ] && [ "$seconds" -le 45 ] || return 1
    deadline=$((start + seconds))
    [ "$(hive_now)" -lt "$deadline" ] || return 1
    printf '%s\n' "$deadline" > "$HIVE_ACCESS_DIR/$role.lease.new" && mv -f "$HIVE_ACCESS_DIR/$role.lease.new" "$HIVE_ACCESS_DIR/$role.lease"
}
hive_xray_epoch() { systemctl show -p InvocationID --value xray; }
hive_snapshot_traffic() {
    systemctl is-active --quiet xray || return 0
    local epoch stats tmp generation=0
    epoch=$(hive_xray_epoch) || return 1
    [[ "$epoch" =~ ^[a-zA-Z0-9_-]{1,128}$ ]] || return 1
    stats=$(xray api statsquery --server=127.0.0.1:10085 -timeout 3 -pattern 'user>>>sub-') || return 1
    [ "$epoch" = "$(hive_xray_epoch)" ] || return 1
    if [ -f "$HIVE_TRAFFIC_GENERATION" ]; then
        generation=$(jq -er --arg epoch "$epoch" '
          if .epoch == $epoch then .generation else "0" end |
          select(type == "string" and test("^(0|[1-9][0-9]{0,18})$"))
        ' "$HIVE_TRAFFIC_GENERATION") || return 1
    fi
    tmp=$(mktemp "$HIVE_TRAFFIC_DIR/.snapshot.XXXXXX") || return 1
    if ! printf '%s' "$stats" | jq -e --arg epoch "$epoch" --arg generation "$generation" '
        if type != "object" or ((.stat // []) | type != "array") then error("invalid stats") else . end |
        {epoch: $epoch, generation: $generation, counters: [(.stat // [])[] |
          select(.name | test("^user>>>sub-[1-9][0-9]*>>>traffic>>>(uplink|downlink)$")) |
          {name, value: ((.value // "0") | tostring)}]} |
        if all(.counters[]; .value | test("^[0-9]+$")) then . else error("invalid counter") end
    ' > "$tmp"; then rm -f "$tmp"; return 1; fi
    chmod 600 "$tmp"
    mv -f "$tmp" "$HIVE_TRAFFIC_DIR/$epoch.json"
}
hive_stop_xray() {
    # Capture the final counters before terminating existing connections.
    hive_snapshot_traffic || true
    systemctl stop xray || systemctl kill --kill-who=all --signal=KILL xray || return 1
    rm -f "$HIVE_ACCESS_DIR/xray.lease" "$HIVE_ACCESS_DIR/xray.applied"
}
hive_gateway_enabled() (
    [ ! -f /etc/hive/config.env ] || source /etc/hive/config.env
    enabled=${GATEWAY_ENABLED:-on}
    case "${enabled,,}" in off|0|false|no) exit 1;; esac
)
hive_gateway_block_forward() {
    local tool
    for tool in iptables ip6tables; do
        "$tool" -w 3 -C FORWARD -m comment --comment hive-subscription -j DROP 2>/dev/null ||
          "$tool" -w 3 -I FORWARD 1 -m comment --comment hive-subscription -j DROP || return 1
    done
}
hive_gateway_unblock_forward() {
    local tool
    for tool in iptables ip6tables; do
        while "$tool" -w 3 -C FORWARD -m comment --comment hive-subscription -j DROP 2>/dev/null; do
            "$tool" -w 3 -D FORWARD -m comment --comment hive-subscription -j DROP || return 1
        done
    done
}
hive_gateway_clear_access() {
    rm -f "$HIVE_ACCESS_DIR/gateway.lease" || return 1
    hive_gateway_unblock_forward
}
hive_disable_gateway() {
    # Stopping Mihomo removes its TUN path without touching other forwarding.
    systemctl stop hive-mihomo || systemctl kill --kill-who=all --signal=KILL hive-mihomo || return 1
    hive_gateway_clear_access
}
hive_tun_ipv4() {
    # 本机自身的出站流量也被 auto-route 送进 TUN（table 2022/52 + suppress_prefixlength），
    # 源地址就是 TUN 地址。fail-closed 规则必须按源地址放行它。
    # 不能用 PROCESS-NAME：实测本机 mihomo 匹配不到进程名（连 find-process-mode=always
    # 也不行），于是 curl/openssl 等一律落到 MATCH,REJECT —— 节点连注册和配置拉取都
    # 做不到，永远拿不到"真"配置，形成自锁。地址来源依次是配置里的 inet4-address、
    # mihomo 默认值 198.18.0.1（fallback 与 registry 两份模板都用 RAW 默认）。
    local addr file=${1:-/etc/mihomo/config.yaml}
    addr=$(awk '
        /^tun:[[:space:]]*$/ { in_tun = 1; next }
        in_tun && /^[^[:space:]#]/ { in_tun = 0 }
        in_tun && /^[[:space:]]*inet4-address:/ {
            value = $0
            sub(/^[[:space:]]*inet4-address:[[:space:]]*/, "", value)
            if (value !~ /^[0-9]/) { want_next = 1; next }
            sub(/#.*/, "", value); gsub(/[",[:space:]]/, "", value); sub(/\/.*/, "", value)
            if (value ~ /^[0-9.]+$/) { print value; exit }
        }
        want_next && /^[[:space:]]*-[[:space:]]*[0-9]/ {
            value = $0
            sub(/^[[:space:]]*-[[:space:]]*/, "", value)
            sub(/#.*/, "", value); gsub(/[",[:space:]]/, "", value); sub(/\/.*/, "", value)
            if (value ~ /^[0-9.]+$/) { print value; exit }
        }
    ' "$file" 2>/dev/null)
    [ -n "$addr" ] || addr=198.18.0.1
    printf '%s/32\n' "$addr"
}
hive_tun_ipv6() {
    # IPv4 版同样的理由，只是 v6 那边连 PROCESS-NAME 都不用试：auto-route 会把
    # fdfe:dcba:9876::/126 的 ::1 当成本机源地址，EasyTier 对端的 IPv6 直连包
    # （[fdfe:dcba:9876::1]:11010 --> 公网 v6）实测全部落到 MATCH using REJECT，
    # 于是 P2P 打洞和依赖 v6 的控制面一起挂掉。地址取自 inet6-address，
    # 缺省用 mihomo 的默认值 fdfe:dcba:9876::1。
    local addr file=${1:-/etc/mihomo/config.yaml}
    addr=$(awk '
        /^tun:[[:space:]]*$/ { in_tun = 1; next }
        in_tun && /^[^[:space:]#]/ { in_tun = 0 }
        in_tun && /^[[:space:]]*inet6-address:/ {
            value = $0
            sub(/^[[:space:]]*inet6-address:[[:space:]]*/, "", value)
            if (value !~ /^[0-9a-fA-F:]/) { want_next = 1; next }
            sub(/#.*/, "", value); gsub(/[",[:space:]]/, "", value); sub(/\/.*/, "", value)
            if (value ~ /^[0-9a-fA-F:]+$/) { print value; exit }
        }
        want_next && /^[[:space:]]*-[[:space:]]*[0-9a-fA-F:]/ {
            value = $0
            sub(/^[[:space:]]*-[[:space:]]*/, "", value)
            sub(/#.*/, "", value); gsub(/[",[:space:]]/, "", value); sub(/\/.*/, "", value)
            if (value ~ /^[0-9a-fA-F:]+$/) { print value; exit }
        }
    ' "$file" 2>/dev/null)
    [ -n "$addr" ] || addr=fdfe:dcba:9876::1
    printf '%s/128\n' "$addr"
}
# Delivered configs are written for customer traffic; the node's own control plane
# has to be carved out of them. Two things get normalized here:
#   - 本机源地址直连（v4/v6）；
#   - dns.respect-rules=false：交付配置里它是 true，于是 mihomo 自己的 DoH
#     （223.5.5.5:443 等）也要过规则；当节点没有可用上游时终端规则是
#     RULE-SET,cn_domain,REJECT / MATCH,REJECT，实测日志
#     "[TCP] mihomo --> 223.5.5.5:443 match Match using REJECT" —— 解析全灭，
#     tailscaled 注册 new node 时 "context deadline exceeded"，节点在面板上失联。 registry/frp/easytier hosts are ordinary .cn names
# and land in rule sets such as cn_domain -> REJECT, and PROCESS-NAME does not match
# on this board (measured, see docs/GATEWAY.md). The TUN source address is the only
# stable handle, so prepend it to whatever config is about to be installed.
hive_gateway_fakeip_filter() {
    # tailscaled 的控制面连接**绑定在物理网卡地址**上：实测
    #   SYN-SENT 192.168.5.222:36686 -> 198.18.0.20:443 users:(("tailscaled",pid=2791))
    # 198.18.0.20 是 fake-IP，只有"源地址 198.18.0.1、走 TUN"的流量才有 mihomo 反向映射；
    # 绑定端0 的 SYN 直接出公网 → 永远 SYN-SENT，注册 10s 超时，节点进不了 tailnet。
    # 把 Tailscale 域名排除出 fake-IP（拿到真实 A/AAAA），它们仍按域名走规则分流。
    local file=${1:-}
    [ -n "$file" ] && [ -s "$file" ] || return 1
    python3 - "$file" <<'PYEOF'
import pathlib, re, sys
path = pathlib.Path(sys.argv[1])
text = path.read_text()
if re.search(r"^\s*-\s*['\"]?\+\.tailscale\.com['\"]?\s*$", text, re.M):
    sys.exit(0)
lines = text.splitlines()
wanted = ("+.tailscale.com", "+.tailscale.io")
start = next((i for i, l in enumerate(lines) if re.match(r"^\s*fake-ip-filter:\s*$", l)), None)
if start is not None:
    indent = re.match(r"^(\s*)", lines[start]).group(1) + "  "
    end = start + 1
    while end < len(lines) and lines[end].startswith(indent) and lines[end].strip():
        end += 1
    lines[end:end] = [f"{indent}- '{domain}'" for domain in wanted]
else:
    mode = next((i for i, l in enumerate(lines) if re.match(r"^\s*enhanced-mode:\s*fake-ip", l)), None)
    if mode is None:
        sys.exit(0)
    indent = re.match(r"^(\s*)", lines[mode]).group(1)
    block = [f"{indent}fake-ip-filter:"] + [f"{indent}  - '{domain}'" for domain in wanted]
    lines[mode + 1:mode + 1] = block
path.write_text("\n".join(lines) + "\n")
PYEOF
}
hive_gateway_self_direct() {
    local file=${1:-} r4 r6 need4=0 need6=0 tmp
    [ -n "$file" ] && [ -s "$file" ] || return 1
    r4="SRC-IP-CIDR,$(hive_tun_ipv4 "$file"),DIRECT"
    r6="SRC-IP-CIDR,$(hive_tun_ipv6 "$file"),DIRECT"
    # Idempotent per family: a config that already carries one of them (registry
    # template or an earlier run) must gain only the missing line.
    grep -qF "$r4" "$file" || need4=1
    grep -qF "$r6" "$file" || need6=1
    # 早退条件必须把三件事都算上：v4/v6 源地址规则、respect-rules、tailscale 的
    # fake-IP 例外。只看前两条会在"registry 模板已经带规则"时跳过 fake-IP 过滤，
    # tailscaled 照样 SYN 黑洞（实测 filter 没落地、注册仍超时）。
    need_dns=0
    grep -qE '^[[:space:]]*respect-rules:[[:space:]]*true' "$file" && need_dns=1
    need_ts=0
    grep -qF "+.tailscale.com" "$file" || need_ts=1
    [ "$need4" -eq 0 ] && [ "$need6" -eq 0 ] && [ "$need_dns" -eq 0 ] && [ "$need_ts" -eq 0 ] && return 0
    tmp=$(mktemp "$(dirname "$file")/.selfdirect.XXXXXX") || return 1
    if ! awk -v r4="$r4" -v r6="$r6" -v n4="$need4" -v n6="$need6" -v ndns="$need_dns" '
        ndns && /^[[:space:]]*respect-rules:[[:space:]]*true/ {
            print "  respect-rules: false"
            ndns = 0
            next
        }
        done {print; next}
        !done && /^rules:[[:space:]]*$/ {
            print
            if (n4) print "  - " r4
            if (n6) print "  - " r6
            done = 1
            next
        }
        {print}
    ' "$file" > "$tmp"; then
        rm -f "$tmp"
        return 1
    fi
    chmod 600 "$tmp"
    mv -f "$tmp" "$file"
    hive_gateway_fakeip_filter "$file"
}
hive_gateway_block_config() {
    local tmp tun_src tun6_src
    [ -s /etc/mihomo/config.yaml ] || return 1
    tun_src=$(hive_tun_ipv4) || return 1
    tun6_src=$(hive_tun_ipv6) || return 1
    tmp=$(mktemp /etc/mihomo/.blocked.XXXXXX) || return 1
    # 客户流量照旧拒绝；但节点自己的控制面（注册、订阅、CF API、FRP、tailscale、NTP/DNS）
    # 必须永远通，否则 fail-closed 会把自己关死。PROCESS-NAME 保留，作为能匹配时的精确白名单。
    #
    # dns.respect-rules 必须在这里关掉：它让 mihomo 自己的解析请求也走规则引擎，而
    # MATCH,REJECT 会把它们全部拒掉（实测日志 "[TCP] mihomo --> 223.5.5.5:443 match
    # Match using REJECT"）。解析一死，节点连 registry 的域名都解不出来，订阅租约永远
    # 拿不到，fail-closed 就变成永久自锁。关掉后 DNS 走默认直连出口，不改客户侧策略。
    awk -v tun="$tun_src" -v tun6="$tun6_src" '
        /^rules:/ {exit}
        /^[[:space:]]*respect-rules:/ {print "  respect-rules: false"; next}
        {print}
        END {
            print "rules:"
            print "  - SRC-IP-CIDR," tun ",DIRECT"
            print "  - SRC-IP-CIDR," tun6 ",DIRECT"
            print "  - PROCESS-NAME,curl,DIRECT"
            print "  - PROCESS-NAME,xray,DIRECT"
            print "  - PROCESS-NAME,cloudflared,DIRECT"
            print "  - PROCESS-NAME,easytier-core,DIRECT"
            print "  - PROCESS-NAME,frpc,DIRECT"
            print "  - PROCESS-NAME,tailscaled,DIRECT"
            print "  - MATCH,REJECT"
        }' /etc/mihomo/config.yaml > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" /etc/mihomo/config.yaml
    hive_gateway_fakeip_filter /etc/mihomo/config.yaml
}
hive_stop_gateway() {
    hive_gateway_block_forward || return 1
    hive_gateway_block_config || { systemctl stop hive-mihomo; return 1; }
    systemctl restart hive-mihomo || systemctl stop hive-mihomo || return 1
    rm -f "$HIVE_ACCESS_DIR/gateway.lease"
}
