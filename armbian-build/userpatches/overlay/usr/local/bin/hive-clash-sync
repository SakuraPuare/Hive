#!/usr/bin/env bash
# A short server lease is required even for an unchanged gateway configuration.
set -euo pipefail
umask 077
[ ! -f /etc/hive/config.env ] || source /etc/hive/config.env
[ ! -s /etc/hive/device-token ] || NODE_REGISTRY_API_SECRET=$(cat /etc/hive/device-token)
source /usr/local/bin/hive-node-info
hive_load_node_info /etc/hive/node-info
source /usr/local/bin/hive-subscription-state
exec 9>"$HIVE_ACCESS_DIR/gateway.sync.lock"
flock -n 9 || exit 0
case "${GATEWAY_ENABLED:-on}" in off|0|false|no) hive_stop_gateway; exit 0;; esac
fail() {
    echo "[hive-clash-sync] $*"
    if ! hive_lease_valid gateway; then hive_stop_gateway || true; fi
    exit 1
}
[ -n "${NODE_REGISTRY_URL:-}" ] && [ -n "${MAC:-}" ] && [ -n "${NODE_REGISTRY_API_SECRET:-}" ] || fail 'device credentials missing'
systemctl is-active --quiet hive-subscription-guard.timer || fail 'subscription watchdog is not running'
tmp=$(mktemp /etc/mihomo/.sync.XXXXXX)
headers=$(mktemp "$HIVE_ACCESS_DIR/headers.XXXXXX")
trap 'rm -f "$tmp" "$headers"' EXIT
request_started=$(hive_now)
curl -4 -fsS --max-time 5 -H "Authorization: Bearer $NODE_REGISTRY_API_SECRET" \
    -D "$headers" -o "$tmp" "${NODE_REGISTRY_URL}/nodes/${MAC}/clash-config" || fail 'configuration request failed'
lease=$(awk 'tolower($1)=="x-hive-lease-seconds:" {gsub("\r", "", $2); print $2}' "$headers")
access=$(awk 'tolower($1)=="x-hive-access:" {gsub("\r", "", $2); print $2}' "$headers")
[[ "$access" = active || "$access" = blocked ]] || fail 'missing access decision'
SAFE_PATHS=/var/www/metacubexd mihomo -t -d /etc/mihomo -f "$tmp" >/dev/null 2>&1 || fail 'invalid gateway configuration'
hive_lease_write gateway "$request_started" "$lease" || fail 'invalid or expired authorization'
if ! cmp -s "$tmp" /etc/mihomo/config.yaml || ! systemctl is-active --quiet hive-mihomo; then
    # Restart closes existing tunnels when a subscription is revoked or changed.
    hive_gateway_block_forward || fail 'cannot block forwarding'
    mv -f "$tmp" /etc/mihomo/config.yaml
    systemctl restart hive-mihomo || { hive_stop_gateway; exit 1; }
fi
hive_lease_valid gateway || { hive_stop_gateway; exit 1; }
if [ "$access" = active ]; then hive_gateway_unblock_forward; else hive_gateway_block_forward; fi
