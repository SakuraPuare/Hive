#!/usr/bin/env bash
# Gateway TPROXY data path. Only forwarded client traffic on the LAN/AP
# interfaces enters Mihomo; the node's own output never does, so the exit
# Xray, registry, cloudflared and Tailscale stay direct without any self-direct
# hacks. DNS from clients is redirected to the Mihomo resolver for fake-IP.
set -euo pipefail

NFT_TABLE=hive_gateway
MARK=${HIVE_GATEWAY_TPROXY_MARK:-0x2}
TABLE=${HIVE_GATEWAY_TPROXY_TABLE:-100}
PREF=100
PORT=7893
DNS_PORT=1053
NODE_INFO=/etc/hive/node-info

[ -f /etc/hive/config.env ] && source /etc/hive/config.env 2>/dev/null || true
enabled=${GATEWAY_ENABLED:-on}

read_field() { { sed -n "s/^$1=//p" "$NODE_INFO" 2>/dev/null || true; } | head -1; }

interfaces() {
    local lan one wan wifi5 wifi i d
    lan=$(read_field GATEWAY_LAN_IFACES)
    one=$(read_field GATEWAY_ONE_ARM_IFACE)
    wan=$(read_field GATEWAY_WAN_IFACE)
    wifi5=$(read_field WIFI_IFACE_5G)
    wifi=$(read_field WIFI_IFACE)
    add_interface() {
        local i=$1
        [ -n "$i" ] || return 0
        case "$i" in *[!a-zA-Z0-9_.:-]*) return 0 ;; esac
        [ "$i" = "$wan" ] && [ "$i" != "$one" ] && return 0
        case " $IFS_OUT " in *" $i "*) return 0 ;; esac
        IFS_OUT="${IFS_OUT:+$IFS_OUT }$i"
    }
    for i in $lan $one $wifi5 $wifi; do add_interface "$i"; done
    # A wireless AP interface can exist before provision/hotspot has written
    # WIFI_IFACE* into node-info. Detect it directly so the first boot (and a
    # failed route start) still installs TPROXY on the AP.
    for d in /sys/class/net/*/phy80211; do
        [ -e "$d" ] || continue
        i=${d#/sys/class/net/}
        i=${i%/phy80211}
        add_interface "$i"
    done
}

stop() {
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    ip rule del fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
    ip -6 rule del fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
    ip route flush table "$TABLE" 2>/dev/null || true
    ip -6 route flush table "$TABLE" 2>/dev/null || true
}

start() {
    command -v nft >/dev/null 2>&1 || { echo '[hive-gateway-route] nft is missing' >&2; exit 1; }
    command -v ip >/dev/null 2>&1 || { echo '[hive-gateway-route] ip is missing' >&2; exit 1; }
    IFS_OUT=""
    interfaces
    if [ "$enabled" != on ]; then
        stop
        echo "[hive-gateway-route] gateway disabled; no TPROXY rules"
        return 0
    fi
    # First boot: node-info/hotspot and the mihomo config can appear after this
    # unit. Wait briefly so the AP interface and config are both available
    # before installing rules; the mihomo unit Requires= this unit.
    for _ in $(seq 1 30); do
        [ -n "$IFS_OUT" ] && [ -s /etc/mihomo/config.yaml ] && break
        sleep 2
        IFS_OUT=""
        interfaces
    done
    if [ -z "$IFS_OUT" ] || [ ! -s /etc/mihomo/config.yaml ]; then
        stop
        echo "[hive-gateway-route] no LAN/AP interface or no mihomo config; no TPROXY rules"
        return 0
    fi
    local ifset
    ifset=$(printf '%s\n' $IFS_OUT | sed 's/^/"/; s/$/"/' | paste -sd, -)
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    nft -f - <<EOF
table inet $NFT_TABLE {
    chain dns_redirect {
        type nat hook prerouting priority dstnat; policy accept;
        iifname { $ifset } udp dport 53 redirect to :$DNS_PORT
        iifname { $ifset } tcp dport 53 redirect to :$DNS_PORT
    }
    chain prerouting {
        type filter hook prerouting priority 0; policy accept;
        fib daddr type local return
        meta nfproto ipv4 iifname { $ifset } meta l4proto { tcp, udp } tproxy ip to :$PORT meta mark set $MARK accept
        meta nfproto ipv6 iifname { $ifset } meta l4proto { tcp, udp } tproxy ip6 to :$PORT meta mark set $MARK accept
    }
    chain input {
        type filter hook input priority -10; policy accept;
        meta mark $MARK accept
        iifname { $ifset } udp dport $DNS_PORT accept
        iifname { $ifset } tcp dport $DNS_PORT accept
    }
}
EOF
    ip rule del fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
    ip rule add fwmark "$MARK" lookup "$TABLE" pref "$PREF"
    ip route replace local 0.0.0.0/0 dev lo table "$TABLE"
    ip -6 rule del fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
    ip -6 rule add fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
    ip -6 route replace local ::/0 dev lo table "$TABLE" 2>/dev/null || true
    echo "[hive-gateway-route] tproxy ifaces=$IFS_OUT port=$PORT mark=$MARK table=$TABLE"
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    *) echo "usage: $0 start|stop" >&2; exit 2 ;;
esac
