#!/usr/bin/env bash
# Durable application rollback. A copy of this file is saved before changing
# any application, so boot recovery does not depend on the newly installed code.
OTA_ROOT=""
OTA_STATE="/var/lib/hive"
OTA_TX="${OTA_STATE}/ota-transaction"

ota_safe_path() {
    local path="$1" dest
    [[ "$path" =~ ^[A-Za-z0-9_.@+/-]+$ ]] || return 1
    case "/$path/" in *'/../'*|*'/./'*|*'//'*) return 1;; esac
    dest="${OTA_ROOT}/${path}"
    [ ! -L "$dest" ] && [ "$(realpath -m -- "$dest")" = "$dest" ]
}

# 启动/恢复关键文件。hive-data 失败时 /data 挂不上，回滚（备份在
# /var/lib/hive）就永远跑不到，所以这些文件只能随固件 OTA 更新。
# 与 scripts/build-ota.sh 的 ota_protected_path 保持一致。
ota_protected_path() {
    case "$1" in
        boot|boot/*|usr/lib/hive|usr/lib/hive/*|usr/lib/modules|usr/lib/modules/*) return 0 ;;
        usr/lib/systemd/system|usr/lib/systemd/system/*) return 0 ;;
        usr/local/bin/hive-data|usr/local/bin/hive-data-grow) return 0 ;;
        usr/local/bin/hive-board|usr/local/bin/hive-node-info) return 0 ;;
        usr/local/bin/hive-firmware) return 0 ;;
        # 事务目录在 ota_prepare 之后才被写入：包内容能覆盖 recover.sh/paths.json，
        # 让下次开机回滚跑的是包带来的引擎。
        var/lib/hive/ota-transaction|var/lib/hive/ota-transaction/*) return 0 ;;
        # Prefix match also covers .d/ drop-ins and .wants/ links, which would
        # otherwise let a bundle rewrite a protected unit through a side path.
        etc/systemd/system/hive-data.service*) return 0 ;;
        etc/systemd/system/hive-ota-recover.service*) return 0 ;;
        etc/systemd/system/hive-firmware-confirm.service*) return 0 ;;
    esac
    return 1
}

# 事务状态全部落在 /var/lib/hive，由 hive-data 从 /data bind 挂载。没有这个
# 挂载时备份和标记只存在于当前 rootfs 槽，切槽即丢，回滚引擎再也跑不到。
ota_state_persistent() {
    [ ! -f /usr/lib/hive/ab-layout ] || mountpoint -q /data
}

ota_save_ack() {
    local status="$1" result="$2" assignment="$3" version="$4"
    [ -n "$assignment" ] || return 0
    jq -n --arg s "$status" --arg r "$result" --arg a "$assignment" --arg v "$version" \
        '{status:$s,result:$r,assignment_token:$a,version:$v}' > "${OTA_STATE}/ota-pending-ack.json.new" || return 1
    mv -f "${OTA_STATE}/ota-pending-ack.json.new" "${OTA_STATE}/ota-pending-ack.json" || return 1
    sync -f "$OTA_STATE"
}

ota_prepare() {
    local manifest="$1" assignment="$2" version="$3" path dest svc enabled active identity
    [ ! -f "$OTA_TX/active" ] || return 1
    rm -rf -- "$OTA_TX"
    mkdir -p "$OTA_TX/files" || return 1
    cp /usr/local/bin/hive-ota-transaction "$OTA_TX/recover.sh" || return 1
    cp "$manifest" "$OTA_TX/manifest.json" || return 1
    # 身份与运行配置只能由签名 hook 迁移，包内容不能直接替换（与
    # scripts/build-ota.sh 的 --include 限制一致）。清单与 hive-data 的
    # bind 挂载列表对齐：这些路径落在 /data 上，跨固件 OTA 持久化，装着
    # 设备 Token、SSH 凭据、隧道身份和代理配置。
    # hook 需要保护的文件用 rollback_paths 声明：那只是备份，不安装内容。
    identity=$(jq -r '[(.files[]?.path | select(type == "string"))]
        | map(select(test("^(etc/(hive|xray|mihomo|frp|ssh|cloudflared)/|root/[.]ssh/|var/lib/(tailscale|cloudflare-warp|easytier)/)")))
        | join(", ")' "$manifest") || return 1
    if [ -n "$identity" ]; then
        echo "Refusing identity/runtime configuration in OTA bundle: $identity (use a migration hook)" >&2
        return 1
    fi
    jq -n --arg a "$assignment" --arg v "$version" '{assignment:$a,version:$v}' > "$OTA_TX/task.json" || return 1
    jq '[.files[].path, (.rollback_paths[]?)] + ["etc/hive/ota-version", "var/lib/hive/ota-installed.json"] | unique' \
        "$manifest" > "$OTA_TX/paths.json" || return 1
    : > "$OTA_TX/existing"
    while IFS= read -r path; do
        ota_safe_path "$path" || return 1
        if ota_protected_path "$path"; then
            echo "Refusing boot-critical path in OTA bundle: $path (firmware update required)" >&2
            return 1
        fi
        dest="${OTA_ROOT}/${path}"
        if [ -e "$dest" ]; then
            [ -f "$dest" ] || return 1
            mkdir -p "$OTA_TX/files/$(dirname "$path")" || return 1
            cp -a -- "$dest" "$OTA_TX/files/$path" || return 1
            printf '%s\n' "$path" >> "$OTA_TX/existing" || return 1
        fi
    done < <(jq -r '.[]' "$OTA_TX/paths.json")
    : > "$OTA_TX/services"
    while IFS= read -r svc; do
        [ -n "$svc" ] || continue
        [[ "$svc" =~ ^[A-Za-z0-9_@.-]+$ && "$svc" != -* ]] || return 1
        if jq -e --arg s "$svc" '(.restart_services // []) | index($s) != null' "$manifest" >/dev/null; then
            case "$svc" in hive-updater.service|hive-updater|hive-command-agent.service|hive-command-agent|hive-ota-recover*) return 1;; esac
        fi
        enabled=$(systemctl is-enabled "$svc" 2>/dev/null) || true
        active=false
        systemctl is-active --quiet "$svc" && active=true
        printf '%s %s %s\n' "$svc" "${enabled:-disabled}" "$active" >> "$OTA_TX/services" || return 1
    done < <(jq -r '[(.restart_services[]?), (.enable_services[]?)] | unique[]' "$manifest")
    # Flush all backups first. Only then publish the durable mutation marker.
    sync -f "$OTA_TX" || return 1
    touch "$OTA_TX/active" || return 1
    sync -f "$OTA_TX"
}

ota_rollback() {
    local boot="${1:-false}" path dest tmp svc enabled active failed=0 assignment version
    [ -f "$OTA_TX/active" ] || return 0
    # A committed transaction only needs its durable acknowledgement delivered.
    if [ -f "$OTA_TX/committed" ]; then
        assignment=$(jq -r '.assignment' "$OTA_TX/task.json")
        version=$(jq -r '.version' "$OTA_TX/task.json")
        ota_save_ack done 'installed and health checks passed' "$assignment" "$version" || return 1
        rm -rf -- "$OTA_TX"
        return 0
    fi
    while IFS= read -r path; do
        ota_safe_path "$path" || { failed=1; continue; }
        dest="${OTA_ROOT}/${path}"
        if grep -Fxq -- "$path" "$OTA_TX/existing"; then
            mkdir -p "$(dirname "$dest")" || { failed=1; continue; }
            tmp=$(mktemp "${dest}.restore.XXXXXX") || { failed=1; continue; }
            cp -a -- "$OTA_TX/files/$path" "$tmp" && mv -f -- "$tmp" "$dest" || failed=1
        else
            rm -f -- "$dest" || failed=1
        fi
    done < <(jq -r '.[]' "$OTA_TX/paths.json")
    systemctl daemon-reload || failed=1
    while read -r svc enabled active; do
        case "$enabled" in
            enabled) systemctl enable "$svc" >/dev/null 2>&1 || failed=1;;
            enabled-runtime) systemctl enable --runtime "$svc" >/dev/null 2>&1 || failed=1;;
            disabled|not-found) systemctl disable "$svc" >/dev/null 2>&1 || true;;
        esac
        # Queue boot-time restarts without waiting on units ordered after this
        # recovery service. Other services may already have started in parallel.
        if [ "$boot" = true ]; then
            if [ "$active" = true ]; then
                systemctl --no-block restart "$svc" || failed=1
            else
                systemctl --no-block stop "$svc" || true
            fi
        else
            if [ "$active" = true ]; then
                systemctl restart "$svc" || failed=1
            else
                systemctl stop "$svc" || true
            fi
        fi
    done < "$OTA_TX/services"
    sync || failed=1
    assignment=$(jq -r '.assignment' "$OTA_TX/task.json")
    version=$(jq -r '.version' "$OTA_TX/task.json")
    if [ "$failed" -ne 0 ]; then
        ota_save_ack failed 'rollback incomplete; retained backup, manual recovery required' "$assignment" "$version" || true
        return 1
    fi
    ota_save_ack rolled_back 'previous files and service configuration restored' "$assignment" "$version" || return 1
    rm -rf -- "$OTA_TX"
    sync -f "$OTA_STATE"
}

ota_commit() {
    local assignment="$1" version="$2"
    # Boot recovery treats a crash before this marker as a failed installation.
    sync || return 1
    touch "$OTA_TX/committed" || return 1
    sync -f "$OTA_TX" || return 1
    ota_save_ack done 'installed and health checks passed' "$assignment" "$version" || return 1
    rm -rf -- "$OTA_TX"
}

ota_service_healthy() {
    local svc="$1" type result status
    if systemctl is-active --quiet "$svc"; then return 0; fi
    type=$(systemctl show "$svc" -p Type --value)
    result=$(systemctl show "$svc" -p Result --value)
    status=$(systemctl show "$svc" -p ExecMainStatus --value)
    [ "$type" = oneshot ] && [ "$result" = success ] && [ "$status" = 0 ]
}

ota_management_probe() {
    # Unit state cannot tell a working tunnel from a broken one: xray/mihomo/
    # frp configs, routing and unit dependencies are all writable by an
    # application bundle, and a broken path leaves the unit "active" while the
    # device is unreachable. Probe the same authenticated endpoint the updater
    # used to receive this assignment. hive-node-info is a protected file, so
    # the bundle under test cannot fake the identity this probe reads.
    # An unregistered device has no management path to verify.
    (
        local mac auth
        # An unregistered device has no management path to verify.
        [ -s /etc/hive/device-token ] || return 0
        auth=$(cat /etc/hive/device-token) || return 1
        [ -r /etc/hive/config.env ] || return 1
        source /etc/hive/config.env 2>/dev/null || return 1
        source /usr/local/bin/hive-node-info || return 1
        hive_load_node_info /etc/hive/node-info || return 1
        mac=$(printf '%s' "${MAC:-}" | tr 'A-F' 'a-f' | tr -d ':-')
        [[ "$mac" =~ ^[0-9a-f]{12}$ ]] || return 1
        [ -n "${NODE_REGISTRY_URL:-}" ] || return 1
        curl --proto '=http,https' -fsS --connect-timeout 3 --max-time 8 \
            -H "Authorization: Bearer $auth" \
            "${NODE_REGISTRY_URL%/}/nodes/$mac/ota-version" >/dev/null
    )
}

ota_health_check() {
    local manifest="$1" payload="$2" svc elapsed=0 healthy grace timeout_sec probe_failed=false
    grace=$(jq -r '.health_grace_seconds // 5' "$manifest")
    timeout_sec=$(jq -r '.health_timeout_seconds // 30' "$manifest")
    [[ "$grace" =~ ^[0-9]+$ && "$timeout_sec" =~ ^[0-9]+$ ]] || return 1
    [ "$grace" -le 60 ] && [ "$timeout_sec" -ge 1 ] && [ "$timeout_sec" -le 300 ] || return 1
    sleep "$grace"
    while [ "$elapsed" -lt "$timeout_sec" ]; do
        healthy=true
        # An empty health_services array must not disable unit checks: jq's //
        # only falls back on null/false, so [] would silently check nothing.
        while IFS= read -r svc; do
            [[ "$svc" =~ ^[A-Za-z0-9_@.-]+$ && "$svc" != -* ]] || return 1
            ota_service_healthy "$svc" || healthy=false
        done < <(jq -r '(.health_services // []) as $h
            | if ($h | length) > 0 then $h[] else (.restart_services // [])[] end' "$manifest")
        if ! ota_management_probe; then
            healthy=false
            if [ "$probe_failed" = false ]; then
                echo "health check: management endpoint unreachable (registry probe failed)" >&2
                probe_failed=true
            fi
        fi
        if "$healthy"; then
            [ ! -f "$payload/hooks/health-check.sh" ] || timeout "$timeout_sec" bash "$payload/hooks/health-check.sh" || return 1
            return 0
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 1
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    set -uo pipefail
    umask 077
    mkdir -p "$OTA_STATE"
    exec 9>"$OTA_STATE/ota.lock"
    flock -n 9 || exit 75
    ota_rollback true
fi
