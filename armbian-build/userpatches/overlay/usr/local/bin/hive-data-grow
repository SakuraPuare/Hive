#!/usr/bin/env bash
# Called before /data is mounted. Grow only partition 2 of a validated Hive GPT.
# A retry after power loss repeats the same geometry and filesystem resize.
set -euo pipefail
disk=${1:?root disk required}
[[ "$disk" =~ ^/dev/mmcblk[0-9]+$ ]] || exit 1
data="${disk}p2"
! findmnt -rn -S "$data" >/dev/null || { echo 'Data partition already mounted' >&2; exit 1; }
plan=$(sfdisk --json "$disk" | python3 -c '
import json, sys
t=json.load(sys.stdin)["partitiontable"]; p=t["partitions"]
assert t["label"] == "gpt" and t.get("sectorsize", 512) == 512
assert len(p) == 2 and [i.get("name") for i in p] == ["hive-root","hive-data"]
assert p[0]["start"] == 32768
assert p[1]["start"] == p[0]["start"] + p[0]["size"]
print(p[1]["start"], p[1]["size"])
')
read -r start size <<< "$plan"
sectors=$(blockdev --getsz "$disk")
target=$(((sectors - 34 - start) / 2048 * 2048))
[ "$target" -ge "$size" ] || { echo 'Card is smaller than its Hive partition layout' >&2; exit 1; }
if [ "$target" -gt "$size" ]; then
    # The factory GPT backup is near the end of the image, not the larger card.
    sfdisk --no-reread --no-tell-kernel --relocate gpt-bak-std "$disk"
    printf 'size=%s\n' "$target" | sfdisk --no-reread --no-tell-kernel -N 2 "$disk"
    sync
fi
# Refresh p2 even on a retry where the GPT was already written before a crash.
partx --update --nr 2 "$disk"
part=$(blockdev --getsz "$data") || exit 1
[ "$part" -eq "$target" ] || exit 1
# Grow the filesystem only while it is still smaller than the partition. Calling
# resize2fs on an already grown filesystem is not the harmless no-op it looks
# like: libext2fs refuses when the superblock's last-check time predates its
# last-mount time, every mount of /data moves the mount time forward, and
# `e2fsck -p` on an already clean filesystem does not move the check time. Boot
# two would then fail here for good and hive-data would never mount /data.
super=$(tune2fs -l "$data" 2>/dev/null) || exit 1
blocks=$(printf '%s\n' "$super" | sed -n 's/^Block count:[[:space:]]*//p')
bsize=$(printf '%s\n' "$super" | sed -n 's/^Block size:[[:space:]]*//p')
[ -n "$blocks" ] && [ -n "$bsize" ] || exit 1
[ $((blocks*bsize)) -lt $((part*512)) ] || exit 0
# Force the check: preen mode alone can leave the check time stale, which is
# exactly what resize2fs rejects.
e2fsck -pf "$data" || [ "$?" -eq 1 ]
resize2fs "$data"
