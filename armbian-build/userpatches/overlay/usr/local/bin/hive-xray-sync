#!/usr/bin/env bash
# Operator exit servers report cumulative counters and renew a <=45s lease.
# Customer gateways never use their device token for accounting.
# A revocation restarts Xray to terminate existing connections as well as logins.
set -euo pipefail
umask 077
[ ! -f /etc/hive/config.env ] || source /etc/hive/config.env
source /usr/local/bin/hive-node-info
hive_load_node_info /etc/hive/node-info
source /usr/local/bin/hive-subscription-state
exec 9>"$HIVE_ACCESS_DIR/xray.sync.lock"
flock -n 9 || exit 0
# Absence of a separately provisioned server token means customer-device mode.
# Stop historical exit access even if its previous lease has not yet expired.
if [ ! -s /etc/hive/server-token ]; then
    hive_stop_xray
    exit 0
fi
SERVER_TOKEN=$(cat /etc/hive/server-token)
fail() {
    echo "[hive-xray-sync] $*"
    # A transport failure may use the remaining short lease; never extend it.
    if ! hive_lease_valid xray; then hive_stop_xray || true; fi
    exit 1
}
[ -n "${NODE_REGISTRY_URL:-}" ] && [ -n "${MAC:-}" ] && [ -n "$SERVER_TOKEN" ] || fail 'server credentials missing'
systemctl is-active --quiet hive-subscription-guard.timer || fail 'subscription watchdog is not running'
# One-time cutover: old runtime counters were billed by Prometheus. Start a
# fresh epoch instead of charging the entire pre-upgrade lifetime again.
if [ ! -f /var/lib/hive/subscription-accounting-v1 ]; then
    systemctl stop xray || exit 1
    /usr/local/bin/hive-xray-prepare || exit 1
    touch /var/lib/hive/subscription-accounting-v1
fi
/usr/local/bin/hive-xray-prepare || { hive_stop_xray; exit 1; }
# Replay unacknowledged snapshots before starting a new runtime. No bytes are
# counted twice even if a previous response was lost after its DB commit.
post_report() {
    local body status
    body=$(mktemp "$HIVE_ACCESS_DIR/accounting-response.XXXXXX") || return 1
    if ! status=$(curl -4 -sS --max-time 5 -o "$body" -w '%{http_code}' -H "Authorization: Bearer $SERVER_TOKEN" \
      -H 'Content-Type: application/json' --data-binary "@$1" \
      "${NODE_REGISTRY_URL%/}/servers/${MAC}/accounting"); then
        rm -f "$body"; return 1
    fi
    case "$status" in
        200) cat "$body"; rm -f "$body" ;;
        410) rm -f "$body"; return 10 ;; # Permanently fenced, never bill again.
        *) rm -f "$body"; return 1 ;;
    esac
}
replay_reports() {
    local pending generation status order
    # Epochs are random InvocationIDs. Replay by generation, not filename, so
    # final snapshots always reach the panel before the next runtime fences them.
    order=$(mktemp "$HIVE_ACCESS_DIR/accounting-order.XXXXXX") || return 1
    for pending in "$HIVE_TRAFFIC_DIR"/*.json; do
        [ -f "$pending" ] || continue
        generation=$(jq -er '(.generation // "0") | select(type == "string" and test("^(0|[1-9][0-9]{0,18})$"))' "$pending") || { rm -f "$order"; return 1; }
        printf '%s\t%s\n' "$generation" "$pending" >> "$order" || { rm -f "$order"; return 1; }
    done
    # An unchecked process substitution can hide sort/write failures and let a
    # new generation retire snapshots which have never reached the server.
    sort -n -k1,1 -o "$order" "$order" || { rm -f "$order"; return 1; }
    while IFS=$'\t' read -r generation pending; do
        if post_report "$pending" >/dev/null; then status=0; else status=$?; fi
        if [ "$status" -ne 0 ] && [ "$status" -ne 10 ]; then rm -f "$order"; return 1; fi
        if [ "$status" -eq 10 ]; then echo "[hive-xray-sync] discarded retired snapshot: ${pending##*/}" >&2; fi
        rm -f "$pending"
    done < "$order"
    rm -f "$order"
}
prepare_generation() {
    local state generation tmp
    # Only called for a fresh, empty Xray runtime; never relabel existing traffic.
    replay_reports || return 1
    state=$(curl -4 -fsS --max-time 5 -H "Authorization: Bearer $SERVER_TOKEN" \
      "${NODE_REGISTRY_URL%/}/servers/${MAC}/accounting/state") || return 1
    generation=$(printf '%s' "$state" | jq -er '.generation | select(type == "string" and test("^(0|[1-9][0-9]{0,18})$"))') || return 1
    # Keep shell arithmetic exact, including values beyond JSON's 53-bit range.
    if [ "${#generation}" -eq 19 ] && [[ "$generation" > 9223372036854775806 ]]; then return 1; fi
    generation=$((generation + 1))
    tmp=$(mktemp "${HIVE_TRAFFIC_GENERATION}.XXXXXX") || return 1
    if ! jq -n --arg epoch "$epoch" --arg generation "$generation" '{epoch:$epoch,generation:$generation}' > "$tmp" ||
       ! sync -f "$tmp" || ! mv -f "$tmp" "$HIVE_TRAFFIC_GENERATION" || ! sync -f "${HIVE_TRAFFIC_GENERATION%/*}"; then
        rm -f "$tmp"; return 1
    fi
}
replay_reports || fail 'traffic replay failed'
systemctl start xray || fail 'cannot start Xray'
epoch=$(hive_xray_epoch)
if [ "$epoch" != "$(cat "$HIVE_ACCESS_DIR/xray.applied" 2>/dev/null || true)" ] ||
   [ "$epoch" != "$(jq -r '.epoch // empty' "$HIVE_TRAFFIC_GENERATION" 2>/dev/null || true)" ]; then
    # Also kills a legacy public client or orphaned API users after upgrading.
    hive_snapshot_traffic || { hive_stop_xray; exit 1; }
    systemctl restart xray || fail 'cannot reset Xray runtime'
    : > "$HIVE_ACCESS_DIR/xray.users"
    epoch=$(hive_xray_epoch)
    prepare_generation || { hive_stop_xray; fail 'cannot prepare accounting generation'; }
    printf '%s\n' "$epoch" > "$HIVE_ACCESS_DIR/xray.applied"
fi
hive_snapshot_traffic || { hive_stop_xray; exit 1; }
request_started=$(hive_now)
if response=$(post_report "$HIVE_TRAFFIC_DIR/$epoch.json"); then
    :
else
    report_status=$?
    # A fenced runtime must restart before obtaining a new generation. Other
    # errors may consume the remaining lease, but cannot extend authorization.
    rm -f "$HIVE_ACCESS_DIR/xray.applied"
    if [ "$report_status" -eq 10 ]; then hive_stop_xray || true; fi
    fail 'traffic report failed'
fi
if ! printf '%s' "$response" | jq -e '
  (.lease_seconds | type == "number" and . >= 1 and . <= 45 and floor == .) and
  (.users | type == "array") and
  all(.users[]; (.email | test("^sub-[1-9][0-9]*$")) and (.uuid | test("^[0-9a-fA-F-]{36}$"))) and
  (([.users[].email] | unique | length) == (.users | length))
' >/dev/null; then fail 'invalid authorization response'; fi
rm -f "$HIVE_TRAFFIC_DIR/$epoch.json"
desired=$(printf '%s' "$response" | jq -r '.users[] | "\(.email)\t\(.uuid)"' | sort -u)
current=$(sort -u "$HIVE_ACCESS_DIR/xray.users" 2>/dev/null || true)
removed=$(comm -23 <(printf '%s\n' "$current") <(printf '%s\n' "$desired") | sed '/^$/d')
lease=$(printf '%s' "$response" | jq -r '.lease_seconds')
hive_lease_write xray "$request_started" "$lease" || fail 'authorization already expired'
if [ -n "$removed" ]; then
    hive_snapshot_traffic || { hive_stop_xray; exit 1; }
    systemctl restart xray || { hive_stop_xray; exit 1; }
    current=''
    epoch=$(hive_xray_epoch)
    prepare_generation || { hive_stop_xray; fail 'cannot prepare accounting generation'; }
fi
added=$(comm -23 <(printf '%s\n' "$desired") <(printf '%s\n' "$current") | sed '/^$/d')
if [ -n "$added" ]; then
    tmp=$(mktemp "$HIVE_ACCESS_DIR/xray-add.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$added" | jq -Rn '[inputs | split("\t") | {email:.[0], id:.[1], level:0}] | {inbounds:[{tag:"vless-ws", protocol:"vless", settings:{clients:., decryption:"none"}}]}' > "$tmp"
    xray api adu --server=127.0.0.1:10085 -timeout 3 "$tmp" >/dev/null 2>&1 || { hive_stop_xray; exit 1; }
fi
hive_lease_valid xray || { hive_stop_xray; exit 1; }
printf '%s\n' "$desired" | sed '/^$/d' > "$HIVE_ACCESS_DIR/xray.users"
printf '%s\n' "$epoch" > "$HIVE_ACCESS_DIR/xray.applied"
