#!/usr/bin/env bash
# NanoPi Zero2/R28S boot payload installer. This is sourced only after signature and
# payload verification by hive-updater; standalone mode confirms a trial boot.
FW_STATE=/var/lib/hive
FW_PENDING="$FW_STATE/firmware-pending.json"
FW_ENV=/run/hive-fw-env.config
# Empty in production. Tests point it at a sandbox so the installer can be
# exercised without writing to a real /boot.
FW_ROOT=""
# hive-updater defines log(); the standalone (systemd) run needs the same helper.
declare -F log >/dev/null || log() { echo "[hive-firmware] $*"; logger -t "hive-firmware" "$*" 2>/dev/null || true; }
source /usr/local/bin/hive-board

firmware_environment_config() {
    # The offsets must match the U-Boot the image was built with, so derive them
    # from the stamp that build wrote rather than repeating constants here. A
    # mismatch makes fw_setenv write where U-Boot never reads.
    local stamp="${HIVE_UBOOT_ENV:-/usr/lib/hive/uboot-env}" size offset redund
    [ -r "$stamp" ] || return 1
    size=$(sed -n 's/^CONFIG_ENV_SIZE=//p' "$stamp")
    offset=$(sed -n 's/^CONFIG_ENV_OFFSET=//p' "$stamp")
    redund=$(sed -n 's/^CONFIG_ENV_OFFSET_REDUND=//p' "$stamp")
    [[ "$size" =~ ^0x[0-9a-fA-F]+$ && "$offset" =~ ^0x[0-9a-fA-F]+$ && "$redund" =~ ^0x[0-9a-fA-F]+$ ]] || return 1
    printf '%s %s %s\n%s %s %s\n' "$FW_DISK" "$offset" "$size" "$FW_DISK" "$redund" "$size"
}

firmware_layout() {
    local root label part argument slot=""
    local -a cmdline=()
    hive_detect_board || return 1
    [ "$(cat /usr/lib/hive/ab-layout 2>/dev/null)" = "$HIVE_LAYOUT" ] || return 1
    root=$(readlink -f "$(findmnt -n -o SOURCE /)") || return 1
    FW_DISK="/dev/$(lsblk -dn -o PKNAME "$root")"
    [[ "$FW_DISK" =~ ^/dev/mmcblk[0-9]+$ ]] || return 1
    for part in 1 2; do
        [ -b "${FW_DISK}p${part}" ] || return 1
        label=$(lsblk -dn -o PARTLABEL "${FW_DISK}p${part}")
        case "$part:$label" in 1:hive-root|2:hive-data) ;; *) return 1;; esac
    done
    [ "$(cat "/sys/class/block/${FW_DISK##*/}p1/start")" = 32768 ] || return 1
    # There is one root filesystem; only the running letter can update it.
    [ "$root" = "${FW_DISK}p1" ] || return 1
    # Use the actual boot disk, not a Linux mmc index assumed at build time.
    firmware_environment_config > "$FW_ENV" || { log '缺少 /usr/lib/hive/uboot-env，无法定位 U-Boot 环境（镜像不是以 HIVE_AB=yes 构建？）'; return 1; }
    # hive_active is the confirmed letter, which is still the previous letter
    # during a trial. Only the kernel command line identifies the running one.
    IFS=$' \t\n' read -r -a cmdline < /proc/cmdline || return 1
    for argument in "${cmdline[@]}"; do
        case "$argument" in
            hive.slot=*)
                [ -z "$slot" ] || return 1
                slot=${argument#hive.slot=}
                case "$slot" in A|B) ;; *) return 1;; esac
                ;;
            hive.slot) return 1;;
        esac
    done
    case "$slot" in
        A) FW_SLOT=A; FW_OTHER=B;;
        B) FW_SLOT=B; FW_OTHER=A;;
        *) return 1;;
    esac
}

firmware_environment() {
    local changes="$1"
    printf '%s\n' "$changes" > /run/hive-fw-env.update || return 1
    fw_setenv -c "$FW_ENV" -s /run/hive-fw-env.update
}

firmware_stage() {
    local payload="$1" version="$2" sha="$3" assignment="$4" manifest count i fpath src dest expected actual image_sha verified
    local -a hashes=() readback_dests=()
    manifest="$payload/manifest.json"
    firmware_layout || { log '设备没有受支持的 Hive 布局或引导器'; return 1; }
    # Firmware pending/receipt live on /data. Staging without it would arm a
    # trial whose confirmation could never be recorded.
    ota_state_persistent || { log '持久化 /data 未挂载，拒绝固件更新'; return 1; }
    [ ! -e "$FW_PENDING" ] && [ ! -f "$OTA_TX/active" ] || return 1
    [ -z "$(fw_printenv -c "$FW_ENV" -n hive_pending 2>/dev/null)" ] || return 1
    jq -e --arg board "$HIVE_BOARD" --arg layout "$HIVE_LAYOUT" \
        '.kind == "firmware" and .board == $board and .layout == $layout' "$manifest" >/dev/null || return 1
    count=$(jq '.files | length' "$manifest")
    [ "$count" -gt 0 ] || return 1
    # A firmware bundle may only move the boot payload and the kernel data that
    # has to match it. Everything else is an application change and belongs in
    # the signed application bundle, which has file-level rollback; allowing it
    # here would create a second, weaker update path over the same files.
    for i in $(seq 0 $((count - 1))); do
        fpath=$(jq -r ".files[$i].path" "$manifest")
        case "$fpath" in
            boot/Image|boot/uInitrd|boot/dtb/*|usr/lib/modules/*|usr/lib/firmware/*) ;;
            usr/lib/hive/boot-payload.json) ;;
            *) log "固件包包含不允许的路径: $fpath"; return 1 ;;
        esac
        src="$payload/files/$fpath"
        { [ -f "$src" ] && [ ! -L "$src" ]; } || { log "文件缺失: $fpath"; return 1; }
        actual=$(sha256sum "$src" | awk '{print $1}')
        expected=$(jq -r ".files[$i].sha256" "$manifest")
        [ "$actual" = "$expected" ] || { log "文件 sha256 不匹配: $fpath"; return 1; }
        hashes[$i]="$expected"
    done
    jq -e '[.files[].path] | (index("boot/Image") != null) and (index("boot/uInitrd") != null)' "$manifest" >/dev/null || return 1
    log "写入引导载荷 $FW_OTHER"
    ota_save_ack installing "writing boot payload $FW_OTHER" "$assignment" "$version" || return 1
    flush_ack || true
    for i in $(seq 0 $((count - 1))); do
        fpath=$(jq -r ".files[$i].path" "$manifest")
        src="$payload/files/$fpath"
        case "$fpath" in
            boot/Image) dest="$FW_ROOT/boot/Image.$FW_OTHER" ;;
            boot/uInitrd) dest="$FW_ROOT/boot/uInitrd.$FW_OTHER" ;;
            # dtb travels with the kernel it describes: a payload that cannot
            # boot must never take the confirmed letter's device tree with it.
            boot/dtb/*) dest="$FW_ROOT/boot/dtb.$FW_OTHER/${fpath#boot/dtb/}" ;;
            *) dest="$FW_ROOT/$fpath" ;;
        esac
        mkdir -p "$(dirname "$dest")" || return 1
        cp -f "$src" "$dest.fw-new" || return 1
        chmod 0644 "$dest.fw-new" || return 1
        mv -f "$dest.fw-new" "$dest" || return 1
        # Record the exact installed destination; it is hashed again after sync.
        readback_dests[$i]="$dest"
    done
    sync || return 1
    # Verify every installed file after sync, including the letter-specific DTB
    # and shared kernel data, before writing either the pending marker or env.
    # Hash each destination directly instead of feeding a generated list to
    # `sha256sum --check`: the escaped-list format is GNU-specific, and Ubuntu
    # 26.04 ships uutils where such lines do not parse at all.
    verified=0
    for i in $(seq 0 $((count - 1))); do
        [ -n "${readback_dests[$i]:-}" ] || continue
        actual=$(sha256sum -- "${readback_dests[$i]}" | awk '{print $1}')
        actual=${actual#\\}
        [ "$actual" = "${hashes[$i]}" ] || {
            log "写入后校验失败，保留原引导载荷: ${readback_dests[$i]}"; return 1; }
        verified=$((verified + 1))
    done
    [ "$verified" -eq "$count" ] || {
        log '写入后校验失败，保留原引导载荷（校验清单不完整）'; return 1; }
    image_sha=$(jq -r '.files[] | select(.path == "boot/Image") | .sha256' "$manifest")
    [ ! -f "$FW_STATE/ota-installed.json" ] || cp -a "$FW_STATE/ota-installed.json" "$FW_STATE/firmware-previous-receipt.json" || return 1
    [ ! -f /etc/hive/ota-version ] || cp -a /etc/hive/ota-version "$FW_STATE/firmware-previous-version" || return 1
    jq -n --arg version "$version" --arg sha "$sha" --arg target "$FW_OTHER" --arg previous "$FW_SLOT" \
        --arg assignment "$assignment" --arg boot_id "$(cat /proc/sys/kernel/random/boot_id)" --arg image_sha "$image_sha" \
        '{version:$version,sha256:$sha,target:$target,previous:$previous,assignment:$assignment,boot_id:$boot_id,image_sha256:$image_sha}' \
        > "$FW_PENDING.new" || return 1
    mv -f "$FW_PENDING.new" "$FW_PENDING" || return 1
    sync || return 1
    # One redundant environment write arms the trial. A power loss before this
    # point boots the confirmed letter; afterwards bootcmd consumes a bounded
    # attempt and returns to the confirmed letter on its own.
    firmware_environment "hive_pending $FW_OTHER
hive_tries 3" || return 1
    ota_save_ack installing "boot payload $FW_OTHER ready; waiting for reboot validation" "$assignment" "$version"
}

firmware_confirm() {
    [ -f "$FW_PENDING" ] || return 0
    # 2 = cannot even name the running letter. A reboot cannot fix that, and the
    # unit's FailureAction=reboot would turn it into a loop; report it separately
    # so the caller can leave the trial countdown to the bootloader instead.
    firmware_layout || { log '无法确定设备布局或运行槽位，保留 pending 交由引导器计数回退'; return 2; }
    local target version assignment sha svc
    target=$(jq -r .target "$FW_PENDING")
    version=$(jq -r .version "$FW_PENDING")
    assignment=$(jq -r .assignment "$FW_PENDING")
    sha=$(jq -r .sha256 "$FW_PENDING")
    # Confirm only after a reboot; a timer cannot approve the old running kernel.
    [ "$(jq -r .boot_id "$FW_PENDING")" != "$(cat /proc/sys/kernel/random/boot_id)" ] || return 1
    if [ "$target" != "$FW_SLOT" ]; then
        [ "$(jq -r .previous "$FW_PENDING")" = "$FW_SLOT" ] || return 1
        # The trial is over. Clear the marker before anything else can fail:
        # FailureAction=reboot plus a pending file that is never removed is an
        # endless reboot loop, and hive_pending cannot be cleared at all when
        # the environment is unwritable.
        firmware_environment 'hive_pending
hive_tries 0' || log 'warning: hive_pending could not be cleared; the bootloader retries the trial until attempts run out'
        if [ -f "$FW_STATE/firmware-previous-receipt.json" ]; then
            cp -a "$FW_STATE/firmware-previous-receipt.json" "$FW_STATE/ota-installed.json" || log 'warning: previous receipt not restored'
        else rm -f "$FW_STATE/ota-installed.json"; fi
        if [ -f "$FW_STATE/firmware-previous-version" ]; then
            cp -a "$FW_STATE/firmware-previous-version" /etc/hive/ota-version || log 'warning: previous version not restored'
        else rm -f /etc/hive/ota-version; fi
        rm -f "$FW_PENDING" "$FW_STATE/firmware-previous-receipt.json" "$FW_STATE/firmware-previous-version"
        ota_save_ack rolled_back 'trial boot failed; bootloader returned to the confirmed system' "$assignment" "$version" || log 'warning: rollback receipt not delivered'
        return 0
    fi
    # The boot payload has no version file of its own; prove the letter that
    # booted is carrying exactly the payload this update installed.
    [ "$(sha256sum "$FW_ROOT/boot/Image.$FW_SLOT" | awk '{print $1}')" = "$(jq -r .image_sha256 "$FW_PENDING")" ] || return 1
    for svc in NetworkManager.service nginx.service cloudflared.service easytier.service hive-subscription-guard.timer hive-updater.timer hive-command-agent.timer; do
        # 没有 Cloudflare 凭证的节点由 provision-node.sh 记录在案并跳过启用。
        # 它在管理面根本没有可确认的 cloudflared 通道，等它 active 就等于把
        # 这台设备永久判为试启动失败。
        if [ "$svc" = cloudflared.service ] && [ -f /etc/hive/cloudflare-unavailable ]; then
            continue
        fi
        systemctl is-active --quiet "$svc" || return 1
    done
    # Xray serves only operator-controlled exits. Customer images intentionally
    # keep it stopped, which must not make a healthy boot-payload trial roll back.
    if [ -s /etc/hive/server-token ]; then
        systemctl is-active --quiet xray.service || return 1
    fi
    # Verify the actual authenticated management path before blessing a boot.
    source /etc/hive/config.env
    source /usr/local/bin/hive-node-info
    hive_load_node_info /etc/hive/node-info
    local mac auth
    mac=$(printf '%s' "${MAC:-}" | tr 'A-F' 'a-f' | tr -d ':-')
    auth=$(cat /etc/hive/device-token) || return 1
    [[ "$mac" =~ ^[0-9a-f]{12}$ ]] && [ -n "$auth" ] && [ -n "${NODE_REGISTRY_URL:-}" ] || return 1
    curl --proto '=http,https' -fsS --connect-timeout 10 --max-time 20 -H "Authorization: Bearer $auth" \
        "${NODE_REGISTRY_URL%/}/nodes/$mac/ota-version" >/dev/null || return 1
    [ ! -x /etc/hive/firmware-health-check ] || timeout 60 /etc/hive/firmware-health-check || return 1
    # Flip the bootloader first: it is the authoritative switch and nothing may
    # claim the new version before the bootloader agrees. Writing the receipt
    # and /etc/hive/ota-version first left a window where the node reported the
    # new version while hive_active still pointed at the old letter, so a failed
    # or interrupted environment write made the receipt lie about what boots.
    #
    # Once this write lands the boot is confirmed: hive_tries is 0, so a reboot
    # can no longer fall back, and FailureAction=reboot on the still-present
    # gate file would restart the node forever over a bookkeeping error. Every
    # later step is therefore best-effort and must not fail the unit.
    firmware_environment "hive_active $FW_SLOT
hive_pending
hive_tries 0" || return 1
    if ! { sync &&
        jq -n --arg version "$version" --arg sha256 "$sha" '{version:$version,sha256:$sha256}' > "$FW_STATE/ota-installed.json.new" &&
        mv -f "$FW_STATE/ota-installed.json.new" "$FW_STATE/ota-installed.json" &&
        printf '%s\n' "$version" > /etc/hive/ota-version.new &&
        mv -f /etc/hive/ota-version.new /etc/hive/ota-version; }; then
        log "warning: 引导器已确认 $FW_SLOT，但版本回执写入失败；下次固件更新会覆盖回执"
        rm -f "$FW_STATE/ota-installed.json.new" /etc/hive/ota-version.new
    fi
    ota_save_ack done "firmware boot and management checks passed on letter $FW_SLOT" "$assignment" "$version" \
        || log 'warning: firmware confirmation receipt not delivered'
    rm -f "$FW_PENDING" "$FW_STATE/firmware-previous-receipt.json" "$FW_STATE/firmware-previous-version"
    sync -f "$FW_STATE" || log "warning: sync $FW_STATE failed"
    return 0
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    set -uo pipefail
    umask 077
    source /usr/local/bin/hive-ota-transaction
    exec 9>"$FW_STATE/ota.lock"
    flock -w 30 9 || exit 1
    # Allow network and normal services time to become healthy, then let the
    # systemd FailureAction reboot. Bootcmd eventually exhausts the trial count.
    # Bound by elapsed time, not by a fixed iteration count: one failing probe
    # costs 20s and one failing health check 60s, so twelve rounds could reach
    # the unit's TimeoutStartSec and kill a device that was merely slow to
    # reach the registry.
    deadline=$((SECONDS + ${CONFIRM_BUDGET:-150}))
    while [ "$SECONDS" -lt "$deadline" ]; do
        firmware_confirm
        case "$?" in
            0) exit 0 ;;
            # Nothing to confirm against: never reboot a healthy device that
            # cannot name its running letter. The bootloader still decrements
            # hive_tries on its own and returns to the confirmed slot.
            2) log '固件确认暂不可判定（布局/槽位），退出并等待下一次启动'; exit 0 ;;
        esac
        sleep 5
    done
    exit 1
fi
