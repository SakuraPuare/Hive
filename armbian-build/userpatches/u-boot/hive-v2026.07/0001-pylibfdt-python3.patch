Subject: [PATCH] pylibfdt: use Python 3 APIs with modern SWIG

SWIG 4.5 no longer supplies the old Python 2 aliases used by these typemaps.
U-Boot builds pylibfdt with Python 3. Keep property names as Python strings.
Tested with Python 3.14 and SWIG 4.5.1; also valid on the older build hosts.

--- a/scripts/dtc/pylibfdt/libfdt.i_shipped
+++ b/scripts/dtc/pylibfdt/libfdt.i_shipped
@@ -1033,7 +1033,7 @@
 	PyObject *buff;
 
 	if ($1) {
-		resultobj = PyString_FromString(
+		resultobj = PyUnicode_FromString(
 			fdt_string(fdt1, fdt32_to_cpu($1->nameoff)));
 		buff = PyByteArray_FromStringAndSize(
 			(const char *)($1 + 1), fdt32_to_cpu($1->len));
@@ -1070,7 +1070,7 @@
 
 /* typemaps used for fdt_next_node() */
 %typemap(in, numinputs=1) int *depth (int depth) {
-   depth = (int) PyInt_AsLong($input);
+   depth = (int) PyLong_AsLong($input);
    $1 = &depth;
 }
 
